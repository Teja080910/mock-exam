<% if (totalPages > 1) { %>
<div class="d-flex justify-content-between align-items-center py-3">
    <div class="text-muted">
        Showing <%= ((currentPage - 1) * limit) + 1 %>-<%= Math.min(currentPage * limit, totalItems) %> of <%= totalItems %>
    </div>
    <nav>
        <ul class="pagination mb-0">
            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= currentPage - 1 %><%= typeof extraParams !== 'undefined' ? extraParams : '' %>">&laquo; Prev</a>
            </li>
            <% 
                let startPage = Math.max(1, currentPage - 2);
                let endPage = Math.min(totalPages, currentPage + 2);
                if (startPage > 1) { %>
                    <li class="page-item"><a class="page-link" href="?page=1<%= typeof extraParams !== 'undefined' ? extraParams : '' %>">1</a></li>
                    <% if (startPage > 2) { %><li class="page-item disabled"><span class="page-link">...</span></li><% } %>
            <% }
                for (let i = startPage; i <= endPage; i++) { %>
                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                        <a class="page-link" href="?page=<%= i %><%= typeof extraParams !== 'undefined' ? extraParams : '' %>"><%= i %></a>
                    </li>
            <% }
                if (endPage < totalPages) { %>
                    <% if (endPage < totalPages - 1) { %><li class="page-item disabled"><span class="page-link">...</span></li><% } %>
                    <li class="page-item"><a class="page-link" href="?page=<%= totalPages %><%= typeof extraParams !== 'undefined' ? extraParams : '' %>"><%= totalPages %></a></li>
            <% } %>
            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= currentPage + 1 %><%= typeof extraParams !== 'undefined' ? extraParams : '' %>">Next &raquo;</a>
            </li>
        </ul>
    </nav>
</div>
<% } %>

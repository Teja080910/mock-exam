<%
  function isActive(paths) {
    if (!currentPath) return false;
    return paths.some(function(p) { return currentPath === p || currentPath.startsWith(p + '/'); });
  }
  function menuClass(paths) { return isActive(paths) ? 'menu-item active' : 'menu-item'; }
  function subMenuClass(paths) { return isActive(paths) ? 'menu-link active' : 'menu-link'; }
  function parentClass(paths) {
    if (!currentPath) return 'menu-item';
    return isActive(paths) ? 'menu-item open' : 'menu-item';
  }
%>

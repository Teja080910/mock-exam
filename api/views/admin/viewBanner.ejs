<%- include('../layout/header.ejs') %>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <%- include('../layout/sidebar.ejs') %>
                <div class="content-wrapper">
                    <div class="container-xxl flex-grow-1 container-p-y">
                        <div class="row">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h4 class="py-3 mb-4">
                                        <span class="text-muted fw-light">Carousel /</span> View Banners
                                    </h4>
                                    <div class="btnwrap mb-4">
                                        <a href="/add-banner" class="btn btn-primary"><i class='bx bx-plus'></i>Add New Banner</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <div class="row">
                        <div class="col-lg-12 grid-margin stretch-card">
                            <div class="card mb-4">
                                <div class="card-header pb-0">
                                    <h5 class="card-title mb-0">Filter Banners</h5>
                                </div>
                                <div class="card-body pt-3">
                                    <form method="get" action="/view-banner" id="bannerFilterForm">
                                        <div class="row g-3 align-items-center">
                                            <div class="col-md-3">
                                                <label class="form-label text-muted small fw-semibold">Status</label>
                                                <select name="is_active" class="form-select" onchange="document.getElementById('bannerFilterForm').submit()">
                                                    <option value="">All Status</option>
                                                    <option value="1" <%= typeof filters !== 'undefined' && filters.is_active === '1' ? 'selected' : '' %>>Enabled</option>
                                                    <option value="0" <%= typeof filters !== 'undefined' && filters.is_active === '0' ? 'selected' : '' %>>Disabled</option>
                                                </select>
                                            </div>
                                            <div class="col-md-9">
                                                <label class="form-label text-muted small fw-semibold">Search</label>
                                                <div class="input-group">
                                                    <input type="text" name="search" class="form-control" placeholder="Search banner title or description..." value="<%= typeof filters !== 'undefined' ? filters.search : '' %>" />
                                                    <button type="submit" class="btn btn-primary"><i class="bx bx-search"></i></button>
                                                </div>
                                            </div>
                                            <div class="col-12 d-flex justify-content-end gap-2">
                                                <% if (typeof filters !== 'undefined' && (filters.is_active !== '' || filters.search)) { %>
                                                    <a href="/view-banner" class="btn btn-outline-secondary btn-sm"><i class="bx bx-x"></i> Clear Filters</a>
                                                <% } %>
                                                <button type="submit" class="btn btn-primary btn-sm"><i class="bx bx-filter-alt"></i> Apply Filter</button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12 grid-margin stretch-card">
                            <div class="card">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-hover" id="server-banner-table">
                                            <thead>
                                                <tr>
                                                    <th>Sr No</th>
                                                    <th>Title</th>
                                                    <th>Description</th>
                                                    <th>Image</th>
                                                    <th>Order</th>
                                                    <th>Status</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (banner.length === 0) { %>
                                                    <tr>
                                                        <td colspan="7" class="text-center py-4 text-muted">
                                                            <i class="bx bx-info-circle fs-3 d-block mb-2"></i>
                                                            No banners found matching your filter criteria.
                                                        </td>
                                                    </tr>
                                                <% } %>
                                                <% const currentViewUrl = '/view-banner?page=' + currentPage + (typeof extraParams !== 'undefined' ? extraParams : ''); %>
                                                <% banner.forEach(function(allBanner, i){ %>
                                                    <tr>
                                                        <td class="align-middle">
                                                            <strong><%= (currentPage - 1) * limit + i + 1 %></strong>
                                                        </td>
                                                        <td class="align-middle">
                                                            <strong><%= allBanner.title %></strong>
                                                        </td>
                                                        <td class="align-middle">
                                                            <%= allBanner.description %>
                                                        </td>
                                                        <td class="align-middle">
                                                            <img src="./assets/userImages/<%= allBanner.image %>" alt="Banner" style="max-width: 100px; height: auto;">
                                                        </td>
                                                        <td class="align-middle">
                                                            <%= allBanner.order %>
                                                        </td>
                                                        <td class="align-middle">
                                                            <form action="/banner-is-active/<%= allBanner._id %>/toggle" method="POST">
                                                                <input type="hidden" name="returnUrl" value="<%= currentViewUrl %>">
                                                                <div class="form-check form-switch">
                                                                    <input class="form-check-input" type="checkbox" 
                                                                        <%= allBanner.is_active ? 'checked' : '' %>>
                                                                </div>
                                                            </form>
                                                        </td>
                                                        <td class="align-middle">
                                                            <div class="dropdown">
                                                                <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                                                    <i class="bx bx-dots-vertical-rounded"></i>
                                                                </button>
                                                                <div class="dropdown-menu">
                                                                    <a class="dropdown-item btn-view-banner" href="#" data-title="<%= allBanner.title %>" data-description="<%= allBanner.description %>" data-image="<%= allBanner.image %>" data-order="<%= allBanner.order %>" data-is-active="<%= allBanner.is_active %>" data-bs-toggle="modal" data-bs-target="#viewBannerModal">
                                                                        <i class="bx bx-show me-1"></i> View
                                                                    </a>
                                                                    <a class="dropdown-item" href="/edit-banner?id=<%= allBanner._id %>&returnUrl=<%= encodeURIComponent(currentViewUrl) %>">
                                                                        <i class="bx bx-edit-alt me-1"></i> Edit
                                                                    </a>
                                                                    <a class="dropdown-item" href="/delete-banner?id=<%= allBanner._id %>&returnUrl=<%= encodeURIComponent(currentViewUrl) %>" onclick="return confirm('Are you sure you want to delete this banner?')">
                                                                        <i class="bx bx-trash me-1"></i> Delete
                                                                    </a>
                                                                </div>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                <% }); %>
                                            </tbody>
                                         </table>
                                     </div>

                                 <%- include('../partials/pagination', { currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, limit: limit, extraParams: typeof extraParams !== 'undefined' ? extraParams : '' }) %>

                                 </div>
                             </div>
                         </div>
                     </div>

                     </div>
                 </div>
         </div>
     </div>

<%- include('../layout/footer.ejs') %>

<div class="modal fade" id="viewBannerModal" tabindex="-1" aria-labelledby="viewBannerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewBannerModalLabel">Banner Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <img id="viewBannerImage" src="" alt="Banner" class="rounded modal-img-viewable" style="max-width: 100%; max-height: 200px; object-fit: cover;">
                </div>
                <table class="table table-borderless">
                    <tr><td class="fw-bold text-muted" style="width:120px;">Title</td><td id="viewBannerTitle"></td></tr>
                    <tr><td class="fw-bold text-muted">Description</td><td id="viewBannerDesc"></td></tr>
                    <tr><td class="fw-bold text-muted">Order</td><td id="viewBannerOrder"></td></tr>
                    <tr><td class="fw-bold text-muted">Status</td><td id="viewBannerStatus"></td></tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/imageViewer') %>

<script>
    $(document).ready(function() {
        $('.form-check-input').change(function() {
            $(this).closest('form').submit();
        });
        document.querySelectorAll('.btn-view-banner').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                document.getElementById('viewBannerImage').src = './assets/userImages/' + this.dataset.image;
                document.getElementById('viewBannerTitle').textContent = this.dataset.title;
                document.getElementById('viewBannerDesc').innerHTML = this.dataset.description || '-';
                document.getElementById('viewBannerOrder').textContent = this.dataset.order;
                document.getElementById('viewBannerStatus').innerHTML = this.dataset.isActive == '1' || this.dataset.isActive == 'true' ? '<span class="badge bg-success">Enabled</span>' : '<span class="badge bg-danger">Disabled</span>';
            });
        });
    });
</script>

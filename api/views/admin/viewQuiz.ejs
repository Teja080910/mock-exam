<%- include('../layout/header.ejs') %>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <%- include('../layout/sidebar.ejs') %>
            <div class="content-wrapper">
                <div class="container-xxl flex-grow-1 container-p-y">
                    <div class="row">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center">
                                <h4 class="py-3 mb-4"> <span class="text-muted fw-light">Quizzes /</span> View Quizzes</h4>
                                <div class="btnwrap mb-4">
                                    <a href="/add-quiz" class="btn btn-primary"><i class='bx bx-plus'></i>Add New Quiz</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12 grid-margin stretch-card">
                            <div class="card mb-4">
                                <div class="card-header pb-0">
                                    <h5 class="card-title mb-0">Filter Quizzes</h5>
                                </div>
                                <div class="card-body pt-3">
                                    <form method="get" action="/view-quiz" id="quizFilterForm">
                                        <div class="row g-3 align-items-center">
                                            <div class="col-md-3">
                                                <label class="form-label text-muted small fw-semibold">Category</label>
                                                <select name="categoryId" id="filterCategory" class="form-select text-capitalize" onchange="filterSubcategories(true); document.getElementById('quizFilterForm').submit();">
                                                    <option value="">All Categories</option>
                                                    <% if(typeof category !== 'undefined' && category.length > 0) { %>
                                                        <% category.forEach(function(cat){ %>
                                                            <option value="<%= cat._id %>" <%= typeof filters !== 'undefined' && filters.categoryId === String(cat._id) ? 'selected' : '' %>><%= cat.name %></option>
                                                        <% }); %>
                                                    <% } %>
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label text-muted small fw-semibold">Subcategory</label>
                                                <select name="subcategoryId" id="filterSubcategory" class="form-select text-capitalize" onchange="document.getElementById('quizFilterForm').submit();">
                                                    <option value="">All Subcategories</option>
                                                    <% if(typeof subcategory !== 'undefined' && subcategory.length > 0) { %>
                                                        <% subcategory.forEach(function(sub){ %>
                                                            <option value="<%= sub._id %>" data-categoryid="<%= sub.categoryId ? sub.categoryId : '' %>" <%= typeof filters !== 'undefined' && filters.subcategoryId === String(sub._id) ? 'selected' : '' %>><%= sub.name %></option>
                                                        <% }); %>
                                                    <% } %>
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label text-muted small fw-semibold">Status</label>
                                                <select name="is_active" id="filterStatus" class="form-select" onchange="document.getElementById('quizFilterForm').submit();">
                                                    <option value="">All Status</option>
                                                    <option value="1" <%= typeof filters !== 'undefined' && filters.is_active === '1' ? 'selected' : '' %>>Enabled</option>
                                                    <option value="0" <%= typeof filters !== 'undefined' && filters.is_active === '0' ? 'selected' : '' %>>Disabled</option>
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label text-muted small fw-semibold">Search</label>
                                                <div class="input-group">
                                                    <input type="text" name="search" id="filterSearch" class="form-control" placeholder="Search quiz name..." value="<%= typeof filters !== 'undefined' ? filters.search : '' %>" />
                                                    <button type="submit" class="btn btn-primary"><i class="bx bx-search"></i></button>
                                                </div>
                                            </div>
                                            <div class="col-12 d-flex justify-content-end gap-2">
                                                <% if (typeof filters !== 'undefined' && (filters.categoryId || filters.subcategoryId || (filters.is_active !== '' && typeof filters.is_active !== 'undefined') || filters.search)) { %>
                                                    <a href="/view-quiz" class="btn btn-outline-secondary btn-sm"><i class="bx bx-x"></i> Clear Filters</a>
                                                <% } %>
                                                <button type="submit" class="btn btn-primary btn-sm"><i class="bx bx-filter-alt"></i> Apply Filter</button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12 grid-margin stretch-card">
                            <div class="card">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-hover" id="server-quiz-table">
                                            <thead>
                                                <tr>
                                                    <th>Sr No</th>
                                                    <th>Image</th>
                                                    <th>Category</th>
                                                    <th>Subcategory</th>
                                                    <th>Quiz Name</th>
                                                    <th>Questions Amount</th>
                                                    <th>is Enable</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (quiz.length === 0) { %>
                                                    <tr>
                                                        <td colspan="8" class="text-center py-4 text-muted">
                                                            <i class="bx bx-info-circle fs-3 d-block mb-2"></i>
                                                            No quizzes found matching your filter criteria.
                                                        </td>
                                                    </tr>
                                                <% } %>
                                                <% quiz.forEach(function(quizData, i){ 
                                                    const qCount = (typeof questionCountMap !== 'undefined' && questionCountMap[String(quizData._id)] !== undefined) ? questionCountMap[String(quizData._id)] : (typeof question !== 'undefined' ? question.filter(q => q.quizId && String(quizData._id) === String(q.quizId._id)).length : 0);
                                                %>
                                                    <tr>
                                                        <td><%= (currentPage - 1) * limit + i + 1 %></td>
                                                        <td>
                                                            <ul class="list-unstyled users-list m-0 avatar-group d-flex align-items-center">
                                                                <li data-bs-toggle="tooltip" data-popup="tooltip-custom" data-bs-placement="top" class="avatar def-avatar avatar-xs pull-up" title="<%= quizData.name %>" data-bs-original-title="">
                                                                    <img src="./assets/userImages/<%= quizData.image %>"alt="Avatar" class="rounded-circle">
                                                                </li>
                                                            </ul>
                                                        </td>
                                                        <td>
                                                            <span class="badge bg-label-primary"><%= quizData.categoryId ? quizData.categoryId.name : 'No Category' %></span>
                                                        </td>
                                                        <td>
                                                            <span class="badge bg-label-info"><%= quizData.subcategoryId ? quizData.subcategoryId.name : '-' %></span>
                                                        </td>
                                                        <td>
                                                            <strong><%= quizData.name %></strong>
                                                        </td>
                                                        <td>
                                                            <%= qCount %>
                                                        </td>
                                                        <% const currentViewUrl = '/view-quiz?page=' + currentPage + (typeof extraParams !== 'undefined' ? extraParams : ''); %>
                                                        <% if(loginData.is_admin == 1) { %>
                                                            <td class="pe-0">
                                                                <form action="/quiz-is-active/<%= quizData._id %>/toggle" id="featureForm" method="POST">
                                                                    <a id="toggleButton" >
                                                                        <div class="form-check form-switch mb-0">
                                                                            <input type="hidden" name="title" value="<%= quizData.name %>"/>
                                                                            <input type="hidden" name="returnUrl" value="<%= currentViewUrl %>"/>
                                                                            <input class="form-check-input" type="checkbox" name="is_active" <% if(quizData.is_active == 1) { %> checked <% }else{} %>>
                                                                        </div>
                                                                    </a>
                                                                </form>                   
                                                            </td>
                                                                <td>
                                                                    <a class="text-info me-3 btn-view-quiz" href="#" data-id="<%= quizData._id %>" data-name="<%= quizData.name %>" data-image="<%= quizData.image %>" data-category="<%= quizData.categoryId ? quizData.categoryId.name : 'No Category' %>" data-subcategory="<%= quizData.subcategoryId ? quizData.subcategoryId.name : '-' %>" data-is-active="<%= quizData.is_active %>" data-question-count="<%= qCount %>" data-bs-toggle="modal" data-bs-target="#viewQuizModal"><i class="bx bx-show"></i></a>
                                                                    <a class="text-success me-3" href="/edit-quiz?id=<%= quizData._id %>&returnUrl=<%= encodeURIComponent(currentViewUrl) %>"><i class="me-2 bx bx-edit-alt"></i></a>
                                                                    <a class="text-danger me-3" href="/delete-quiz?id=<%= quizData._id %>&returnUrl=<%= encodeURIComponent(currentViewUrl) %>" onclick="return confirm('Are you sure want to delete this quiz?')"><i class="bx bx-trash"></i></a>
                                                                </td>
                                                        <% } else { %>
                                                                <td>
                                                                    <div class="form-check form-switch mb-0" onclick="alert('You have no access to change status..!!')">
                                                                        <input class="form-check-input" type="checkbox" name="is_active" <% if(quizData.is_active==1) { %> checked <% }else{} %>disabled>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <a class="text-info me-3 btn-view-quiz" href="#" data-id="<%= quizData._id %>" data-name="<%= quizData.name %>" data-image="<%= quizData.image %>" data-category="<%= quizData.categoryId ? quizData.categoryId.name : 'No Category' %>" data-subcategory="<%= quizData.subcategoryId ? quizData.subcategoryId.name : '-' %>" data-is-active="<%= quizData.is_active %>" data-question-count="<%= qCount %>" data-bs-toggle="modal" data-bs-target="#viewQuizModal"><i class="bx bx-show"></i></a>
                                                                    <a class="text-success me-3" href="/edit-quiz?id=<%= quizData._id %>&returnUrl=<%= encodeURIComponent(currentViewUrl) %>"><i class="me-2 bx bx-edit-alt"></i></a>
                                                                    <a class="text-danger me-3" href="" onclick="return alert('You have no access to delete this quiz.')"><i class="bx bx-trash"></i></a>
                                                                </td>
                                                    <% } %>
                                                    </tr>
                                                <% }); %>
                                        </tbody>
                                    </table>
                                </div>

                                <%- include('../partials/pagination', { currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, limit: limit, extraParams: typeof extraParams !== 'undefined' ? extraParams : '' }) %>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    <script src="/assets/js/statusEnable.js"></script>

<div class="modal fade" id="viewQuizModal" tabindex="-1" aria-labelledby="viewQuizModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewQuizModalLabel">Quiz Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <img id="viewQuizImage" src="" alt="Quiz Image" class="rounded-circle modal-img-viewable" style="width: 80px; height: 80px; object-fit: cover;">
                </div>
                <table class="table table-borderless">
                    <tr><td class="fw-bold text-muted" style="width:140px;">Name</td><td id="viewQuizName"></td></tr>
                    <tr><td class="fw-bold text-muted">Category</td><td id="viewQuizCategory"></td></tr>
                    <tr><td class="fw-bold text-muted">Subcategory</td><td id="viewQuizSubcategory"></td></tr>
                    <tr><td class="fw-bold text-muted">Questions</td><td id="viewQuizQuestionCount"></td></tr>
                    <tr><td class="fw-bold text-muted">Status</td><td id="viewQuizStatus"></td></tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    function filterSubcategories(resetSelection) {
        const categorySelect = document.getElementById('filterCategory');
        const subcategorySelect = document.getElementById('filterSubcategory');
        if (!categorySelect || !subcategorySelect) return;
        
        const selectedCategoryId = categorySelect.value;
        const options = subcategorySelect.querySelectorAll('option');

        let hasVisibleSelection = false;
        options.forEach(function(opt) {
            if (!opt.value) {
                opt.style.display = '';
                return;
            }
            const optCategoryId = opt.getAttribute('data-categoryid') || '';
            if (!selectedCategoryId || optCategoryId === selectedCategoryId) {
                opt.style.display = '';
                opt.disabled = false;
                if (opt.selected) hasVisibleSelection = true;
            } else {
                opt.style.display = 'none';
                opt.disabled = true;
            }
        });

        if (resetSelection || (!hasVisibleSelection && subcategorySelect.value !== '')) {
            subcategorySelect.value = '';
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        filterSubcategories(false);
    });

    document.querySelectorAll('.btn-view-quiz').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            document.getElementById('viewQuizImage').src = './assets/userImages/' + this.dataset.image;
            document.getElementById('viewQuizName').textContent = this.dataset.name;
            document.getElementById('viewQuizCategory').textContent = this.dataset.category;
            document.getElementById('viewQuizSubcategory').textContent = this.dataset.subcategory;
            document.getElementById('viewQuizQuestionCount').textContent = this.dataset.questionCount || '0';
            document.getElementById('viewQuizStatus').innerHTML = this.dataset.isActive == '1' ? '<span class="badge bg-success">Enabled</span>' : '<span class="badge bg-danger">Disabled</span>';
        });
    });
</script>

<%- include('../partials/imageViewer') %>

<%- include('../layout/footer.ejs') %>

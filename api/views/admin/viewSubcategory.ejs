<%- include('../layout/header.ejs') %>
<div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
        <%- include('../layout/sidebar.ejs') %>
        <div class="content-wrapper">
            <div class="container-xxl flex-grow-1 container-p-y">
                <div class="row">
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="py-3 mb-4">
                                <span class="text-muted fw-light">Subcategory /</span> View Subcategory
                            </h4>
                            <div class="btnwrap mb-4">
                                <a href="/add-subcategory" class="btn btn-primary"><i class='bx bx-plus'></i>Add New Subcategory</a>
                            </div>
                        </div>
                    </div>
                </div>
                    <div class="row">
                        <div class="col-lg-12 grid-margin stretch-card">
                            <div class="card mb-4">
                                <div class="card-header pb-0">
                                    <h5 class="card-title mb-0">Filter Subcategories</h5>
                                </div>
                                <div class="card-body pt-3">
                                    <form method="get" action="/view-subcategory" id="subcategoryFilterForm">
                                        <div class="row g-3 align-items-center">
                                            <div class="col-md-3">
                                                <label class="form-label text-muted small fw-semibold">Category</label>
                                                <select name="categoryId" id="filterCategory" class="form-select text-capitalize" onchange="document.getElementById('subcategoryFilterForm').submit()">
                                                    <option value="">All Categories</option>
                                                    <% if (typeof category !== 'undefined' && category.length > 0) { %>
                                                        <% category.forEach(function(cat){ %>
                                                            <option value="<%= cat._id %>" <%= typeof filters !== 'undefined' && filters.categoryId === String(cat._id) ? 'selected' : '' %>><%= cat.name %></option>
                                                        <% }); %>
                                                    <% } %>
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label text-muted small fw-semibold">Status</label>
                                                <select name="is_active" class="form-select" onchange="document.getElementById('subcategoryFilterForm').submit()">
                                                    <option value="">All Status</option>
                                                    <option value="1" <%= typeof filters !== 'undefined' && filters.is_active === '1' ? 'selected' : '' %>>Enabled</option>
                                                    <option value="0" <%= typeof filters !== 'undefined' && filters.is_active === '0' ? 'selected' : '' %>>Disabled</option>
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label text-muted small fw-semibold">Featured</label>
                                                <select name="is_feature" class="form-select" onchange="document.getElementById('subcategoryFilterForm').submit()">
                                                    <option value="">All</option>
                                                    <option value="1" <%= typeof filters !== 'undefined' && filters.is_feature === '1' ? 'selected' : '' %>>Featured</option>
                                                    <option value="0" <%= typeof filters !== 'undefined' && filters.is_feature === '0' ? 'selected' : '' %>>Not Featured</option>
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label text-muted small fw-semibold">Search</label>
                                                <div class="input-group">
                                                    <input type="text" name="search" class="form-control" placeholder="Search subcategory name..." value="<%= typeof filters !== 'undefined' ? filters.search : '' %>" />
                                                    <button type="submit" class="btn btn-primary"><i class="bx bx-search"></i></button>
                                                </div>
                                            </div>
                                            <div class="col-12 d-flex justify-content-end gap-2">
                                                <% if (typeof filters !== 'undefined' && (filters.categoryId || filters.is_active !== '' || filters.is_feature !== '' || filters.search)) { %>
                                                    <a href="/view-subcategory" class="btn btn-outline-secondary btn-sm"><i class="bx bx-x"></i> Clear Filters</a>
                                                <% } %>
                                                <button type="submit" class="btn btn-primary btn-sm"><i class="bx bx-filter-alt"></i> Apply Filter</button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12 grid-margin stretch-card">
                            <div class="card">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-hover" id="server-subcategory-table">
                                            <thead>
                                                <tr>
                                                    <th>Sr No</th>
                                                    <th>Category</th>
                                                    <th>Image</th>
                                                    <th>Subcategory Name</th>
                                                    <th>is_Enable</th>
                                                    <th>is_feature</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (subcategory.length === 0) { %>
                                                    <tr>
                                                        <td colspan="7" class="text-center py-4 text-muted">
                                                            <i class="bx bx-info-circle fs-3 d-block mb-2"></i>
                                                            No subcategories found matching your filter criteria.
                                                        </td>
                                                    </tr>
                                                <% } %>
                                                <% subcategory.forEach(function(subcat, i){ %>
                                                    <tr>
                                                        <td><strong><%= (currentPage - 1) * limit + i + 1 %></strong></td>
                                                        <td><%= subcat.categoryId ? subcat.categoryId.name : '' %></td>
                                                        <td>
                                                            <img src="/assets/userImages/<%= subcat.image %>" alt="Image" class="rounded-circle" width="40" height="40">
                                                        </td>
                                                        <td><strong><%= subcat.name %></strong></td>
                                                        <td>
                                                            <div class="form-check form-switch mb-0">
                                                                <input class="form-check-input" type="checkbox" <% if(subcat.is_active == 1) { %> checked <% } %> disabled>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <div class="form-check form-switch mb-2">
                                                                <input class="form-check-input" type="checkbox" <% if(subcat.is_feature == 1) { %> checked <% } %> disabled>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <% const currentViewUrl = '/view-subcategory?page=' + currentPage + (typeof extraParams !== 'undefined' ? extraParams : ''); %>
                                                            <div class="d-flex gap-3">
                                                                <a href="#" class="text-info me-3 btn-view-subcategory" data-name="<%= subcat.name %>" data-category="<%= subcat.categoryId ? subcat.categoryId.name : '' %>" data-image="<%= subcat.image %>" data-is-active="<%= subcat.is_active %>" data-is-feature="<%= subcat.is_feature %>" data-bs-toggle="modal" data-bs-target="#viewSubcategoryModal"><i class="bx bx-show"></i></a>
                                                                <a href="/edit-subcategory?id=<%= subcat._id %>&returnUrl=<%= encodeURIComponent(currentViewUrl) %>" class="text-success me-3"><i class="bx bx-edit-alt"></i></a>
                                                                <a href="/delete-subcategory?id=<%= subcat._id %>&returnUrl=<%= encodeURIComponent(currentViewUrl) %>" onclick="return confirm('Are you sure want to delete this <%= subcat.name %>?')" class="text-danger me-3"><i class="bx bx-trash"></i></a>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                <% }); %>
                                            </tbody>
                                        </table>
                                    </div>

                                    <%- include('../partials/pagination', { currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, limit: limit, extraParams: typeof extraParams !== 'undefined' ? extraParams : '' }) %>

                                </div>
                            </div>
                        </div>
                    </div>
            </div>

        <%- include('../layout/footer.ejs') %>

<div class="modal fade" id="viewSubcategoryModal" tabindex="-1" aria-labelledby="viewSubcategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewSubcategoryModalLabel">Subcategory Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <img id="viewSubcategoryImage" src="" alt="Subcategory Image" class="rounded-circle modal-img-viewable" style="width: 80px; height: 80px; object-fit: cover;">
                </div>
                <table class="table table-borderless">
                    <tr><td class="fw-bold text-muted" style="width:120px;">Name</td><td id="viewSubcategoryName"></td></tr>
                    <tr><td class="fw-bold text-muted">Category</td><td id="viewSubcategoryCategory"></td></tr>
                    <tr><td class="fw-bold text-muted">Status</td><td id="viewSubcategoryStatus"></td></tr>
                    <tr><td class="fw-bold text-muted">Featured</td><td id="viewSubcategoryFeature"></td></tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.btn-view-subcategory').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            document.getElementById('viewSubcategoryImage').src = '/assets/userImages/' + this.dataset.image;
            document.getElementById('viewSubcategoryName').textContent = this.dataset.name;
            document.getElementById('viewSubcategoryCategory').textContent = this.dataset.category;
            document.getElementById('viewSubcategoryStatus').innerHTML = this.dataset.isActive == '1' ? '<span class="badge bg-success">Enabled</span>' : '<span class="badge bg-danger">Disabled</span>';
            document.getElementById('viewSubcategoryFeature').innerHTML = this.dataset.isFeature == '1' ? '<span class="badge bg-success">Yes</span>' : '<span class="badge bg-secondary">No</span>';
        });
    });
</script>

<%- include('../partials/imageViewer') %>

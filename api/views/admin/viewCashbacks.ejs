<%- include('../layout/header.ejs') %>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <%- include('../layout/sidebar.ejs') %>
                <div class="container-xxl flex-grow-1 container-p-y">
                    <h4 class="py-3 mb-4">
                        <span class="text-muted fw-light">Users /</span> Cashback Wallet
                    </h4>

                    <div class="row mb-4">
                        <div class="col-md-3 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <div class="text-muted small">Wallet Liability (outstanding)</div>
                                    <h4 class="mb-0">₹<%= ((liability.totalPaise || 0) / 100).toFixed(2) %></h4>
                                    <small class="text-muted"><%= liability.users || 0 %> users with balance</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <div class="text-muted small">Total Earned (credited)</div>
                                    <h4 class="mb-0 text-success">₹<%= ((totals.earn.totalPaise || 0) / 100).toFixed(2) %></h4>
                                    <small class="text-muted"><%= totals.earn.count %> transactions</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <div class="text-muted small">Total Redeemed (used)</div>
                                    <h4 class="mb-0 text-primary">₹<%= ((totals.redeem.totalPaise || 0) / 100).toFixed(2) %></h4>
                                    <small class="text-muted"><%= totals.redeem.count %> transactions</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <div class="text-muted small">Referral Cashback Records</div>
                                    <h4 class="mb-0"><%= referrals %></h4>
                                    <small class="text-muted">all time</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0">Wallet Transactions</h5>
                            <form method="get" action="/view-cashbacks" class="d-flex gap-2">
                                <select name="type" class="form-select form-select-sm" onchange="this.form.submit()">
                                    <option value="">All Types</option>
                                    <option value="earn" <%= typeFilter === 'earn' ? 'selected' : '' %>>Earn</option>
                                    <option value="redeem" <%= typeFilter === 'redeem' ? 'selected' : '' %>>Redeem</option>
                                </select>
                            </form>
                        </div>
                        <div class="table-responsive text-nowrap">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>User</th>
                                        <th>Type</th>
                                        <th>Amount</th>
                                        <th>Description</th>
                                        <th>Related User</th>
                                        <th>Balance After</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (!transactions || transactions.length === 0) { %>
                                        <tr><td colspan="7" class="text-center text-muted py-4">No transactions found</td></tr>
                                    <% } %>
                                    <% transactions.forEach(function (t) { %>
                                        <tr>
                                            <td><%= t.createdAt ? new Date(t.createdAt).toLocaleString('en-IN') : '-' %></td>
                                            <td>
                                                <%= t.userId ? ((t.userId.firstname || '') + ' ' + (t.userId.lastname || '')).trim() : '-' %>
                                                <br><small class="text-muted"><%= t.userId ? (t.userId.email || '') : '' %></small>
                                            </td>
                                            <td>
                                                <% if (t.type === 'earn') { %>
                                                    <span class="badge bg-label-success">Earn</span>
                                                <% } else { %>
                                                    <span class="badge bg-label-primary">Redeem</span>
                                                <% } %>
                                            </td>
                                            <td class="<%= t.type === 'earn' ? 'text-success' : 'text-primary' %> fw-semibold">
                                                <%= t.type === 'earn' ? '+' : '-' %>₹<%= ((t.amountPaise || 0) / 100).toFixed(2) %>
                                            </td>
                                            <td><%= t.title || '-' %></td>
                                            <td>
                                                <%= t.relatedUserId ? ((t.relatedUserId.firstname || '') + ' ' + (t.relatedUserId.lastname || '')).trim() : '-' %>
                                                <% if (t.relatedUserId && t.relatedUserId.email) { %>
                                                    <br><small class="text-muted"><%= t.relatedUserId.email %></small>
                                                <% } %>
                                            </td>
                                            <td>₹<%= ((t.balanceAfterPaise || 0) / 100).toFixed(2) %></td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                        <%- include('../partials/pagination', { currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, limit: limit, extraParams: typeFilter ? ('type=' + typeFilter) : '' }) %>
                    </div>
                </div>
            </div>
        </div>
    </div>
<%- include('../layout/footer.ejs') %>

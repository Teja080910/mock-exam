<%- include('../layout/header.ejs') %>
<div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
        <%- include('../layout/sidebar.ejs') %>
        <div class="content-wrapper">
            <div class="container-xxl flex-grow-1 container-p-y">
                <div class="row">
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="py-3 mb-4">
                                <span class="text-muted fw-light">Category Groups /</span> View Category Groups
                            </h4>
                            <div class="btnwrap mb-4">
                                <a href="/add-category-group" class="btn btn-primary"><i class="bx bx-plus"></i>Add Category Group</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12 grid-margin stretch-card">
                        <div class="card mb-4">
                            <div class="card-header pb-0">
                                <h5 class="card-title mb-0">Filter Category Groups</h5>
                            </div>
                            <div class="card-body pt-3">
                                <form method="get" action="/view-category-groups" id="categoryGroupFilterForm">
                                    <div class="row g-3 align-items-center">
                                        <div class="col-md-3">
                                            <label class="form-label text-muted small fw-semibold">Scope</label>
                                            <select name="scope" class="form-select" onchange="document.getElementById('categoryGroupFilterForm').submit()">
                                                <option value="">All Scopes</option>
                                                <option value="central" <%= typeof filters !== 'undefined' && filters.scope === 'central' ? 'selected' : '' %>>Central wise</option>
                                                <option value="state" <%= typeof filters !== 'undefined' && filters.scope === 'state' ? 'selected' : '' %>>State wise</option>
                                                <option value="none" <%= typeof filters !== 'undefined' && filters.scope === 'none' ? 'selected' : '' %>>None</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label text-muted small fw-semibold">Category</label>
                                            <select name="categoryId" class="form-select text-capitalize" onchange="document.getElementById('categoryGroupFilterForm').submit()">
                                                <option value="">All Categories</option>
                                                <% if (typeof allCategories !== 'undefined') { %>
                                                    <% allCategories.forEach(function(cat) { %>
                                                        <option value="<%= cat._id %>" <%= typeof filters !== 'undefined' && filters.categoryId === String(cat._id) ? 'selected' : '' %>><%= cat.displayName || cat.name %></option>
                                                    <% }); %>
                                                <% } %>
                                            </select>
                                        </div>
                                        <div class="col-md-5">
                                            <label class="form-label text-muted small fw-semibold">Search</label>
                                            <div class="input-group">
                                                <input type="text" name="search" class="form-control" placeholder="Search by name or code..." value="<%= typeof filters !== 'undefined' ? filters.search : '' %>">
                                                <button type="submit" class="btn btn-primary"><i class="bx bx-search"></i></button>
                                            </div>
                                        </div>
                                        <div class="col-12 d-flex justify-content-end gap-2">
                                            <% if (typeof filters !== 'undefined' && (filters.scope || filters.categoryId || filters.search)) { %>
                                                <a href="/view-category-groups" class="btn btn-outline-secondary btn-sm"><i class="bx bx-x"></i> Clear Filters</a>
                                            <% } %>
                                            <button type="submit" class="btn btn-primary btn-sm"><i class="bx bx-filter-alt"></i> Apply Filter</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12 grid-margin stretch-card">
                        <div class="card">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-bordered table-hover">
                                        <thead>
                                            <tr>
                                                <th>Image</th>
                                                <th>Code</th>
                                                <th>Display Name</th>
                                                <th>Scope</th>
                                                <th>Categories</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if (groups.length === 0) { %>
                                                <tr>
                                                    <td colspan="6" class="text-center py-4 text-muted">
                                                        <i class="bx bx-info-circle fs-3 d-block mb-2"></i>
                                                        No category groups found matching your filter criteria.
                                                    </td>
                                                </tr>
                                            <% } %>
                                            <% groups.forEach(function(group) { %>
                                                <% var scope = (group.scope && ['central','state','none'].indexOf(group.scope) !== -1) ? group.scope : 'none'; %>
                                                <% var scopeLabel = scope === 'central' ? 'Central wise' : (scope === 'state' ? 'State wise' : 'None'); %>
                                                <% var scopeClass = scope === 'central' ? 'bg-primary' : (scope === 'state' ? 'bg-success' : 'bg-secondary'); %>
                                                <tr>
                                                    <td>
                                                        <% if (group.image) { %>
                                                            <img src="/assets/userImages/<%= group.image %>" alt="Image" style="width: 50px; height: 50px; border-radius: 8px; object-fit: cover;" />
                                                        <% } else { %>
                                                            <span class="text-muted">No image</span>
                                                        <% } %>
                                                    </td>
                                                    <td><strong><%= group.code || '-' %></strong></td>
                                                    <td><%= group.displayName %></td>
                                                    <td><span class="badge <%= scopeClass %>"><%= scopeLabel %></span></td>
                                                    <td>
                                                        <% group.categories.forEach(function(cat, idx) { %>
                                                            <span class="badge bg-info"><%= cat.displayName || cat.name %></span>
                                                            <% if (idx < group.categories.length - 1) { %>, <% } %>
                                                        <% }) %>
                                                    </td>
                                                    <td>
                                                        <% const currentViewUrl = '/view-category-groups?page=' + currentPage + (typeof extraParams !== 'undefined' ? extraParams : ''); %>
                                                        <a href="#" class="btn btn-sm btn-info me-1 btn-view-category-group" data-code="<%= group.code || '-' %>" data-display-name="<%= group.displayName %>" data-scope="<%= scope %>" data-scope-label="<%= scopeLabel %>" data-categories="<% group.categories.forEach(function(cat, idx) { %><%= cat.displayName || cat.name %><%= idx < group.categories.length - 1 ? ', ' : '' %><% }) %>" data-image="<%= group.image || '' %>" data-bs-toggle="modal" data-bs-target="#viewCategoryGroupModal"><i class="bx bx-show"></i> View</a>
                                                        <a href="/edit-category-group?id=<%= group._id %>&returnUrl=<%= encodeURIComponent(currentViewUrl) %>" class="btn btn-sm btn-warning">Edit</a>
                                                        <a href="/delete-category-group?id=<%= group._id %>&returnUrl=<%= encodeURIComponent(currentViewUrl) %>" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</a>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                                <%- include('../partials/pagination', { currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, limit: limit, extraParams: typeof extraParams !== 'undefined' ? extraParams : '' }) %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <%- include('../layout/footer.ejs') %>
        </div>
    </div>
</div>

<div class="modal fade" id="viewCategoryGroupModal" tabindex="-1" aria-labelledby="viewCategoryGroupModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewCategoryGroupModalLabel">Category Group Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3" id="viewCGImageWrap" style="display:none;">
                    <img id="viewCGImage" src="" alt="Image" class="modal-img-viewable" style="width: 80px; height: 80px; border-radius: 8px; object-fit: cover;" />
                </div>
                <table class="table table-borderless">
                    <tr><td class="fw-bold text-muted" style="width:130px;">Code</td><td id="viewCGCode"></td></tr>
                    <tr><td class="fw-bold text-muted">Display Name</td><td id="viewCGDisplayName"></td></tr>
                    <tr><td class="fw-bold text-muted">Scope</td><td id="viewCGScope"></td></tr>
                    <tr><td class="fw-bold text-muted">Categories</td><td id="viewCGCategories"></td></tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.btn-view-category-group').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            var imgWrap = document.getElementById('viewCGImageWrap');
            if (this.dataset.image) {
                document.getElementById('viewCGImage').src = '/assets/userImages/' + this.dataset.image;
                imgWrap.style.display = '';
            } else {
                imgWrap.style.display = 'none';
            }
            document.getElementById('viewCGCode').textContent = this.dataset.code;
            document.getElementById('viewCGDisplayName').textContent = this.dataset.displayName;
            var scopeClasses = { central: 'bg-primary', state: 'bg-success', none: 'bg-secondary' };
            document.getElementById('viewCGScope').innerHTML = '<span class="badge ' + (scopeClasses[this.dataset.scope] || 'bg-secondary') + '">' + this.dataset.scopeLabel + '</span>';
            document.getElementById('viewCGCategories').textContent = this.dataset.categories || '-';
        });
    });
</script>

<%- include('../partials/imageViewer') %>
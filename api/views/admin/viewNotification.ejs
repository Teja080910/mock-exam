<%- include('../layout/header.ejs') %>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <%- include('../layout/sidebar.ejs') %>
                <div class="content-wrapper">
                    <div class="container-xxl flex-grow-1 container-p-y">
                        <div class="row">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h4 class="py-3 mb-4">
                                        <span class="text-muted fw-light">Notification /</span> View Notifications
                                    </h4>
                                    <div class="btnwrap mb-4">
                                        <a href="/add-notification" class="btn btn-primary"><i class='bx bx-plus'></i>Send Notification</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-12 grid-margin stretch-card">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-hover" id="server-notification-table">
                                                <thead>
                                                    <tr>
                                                        <th>Sr No</th>
                                                        <th>Title</th>
                                                        <th>Description</th>
                                                        <th>Image</th>
                                                        <th>Sent At</th>
                                                        <th>Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% notifications.forEach(function(notification, i){ %>
                                                        <tr>
                                                            <td class="align-center">
                                                                <strong><%= (currentPage - 1) * limit + i + 1 %></strong>
                                                            </td>
                                                            <td>
                                                                <strong><%= notification.title %></strong>
                                                            </td>
                                                            <td>
                                                                <%- notification.description %>
                                                            </td>
                                                            <td>
                                                                <% if (notification.image) { %>
                                                                    <img src="/assets/userImages/<%= notification.image %>" width="60" height="40" style="object-fit:cover;border-radius:6px;" />
                                                                <% } else { %>
                                                                    <span class="text-muted">-</span>
                                                                <% } %>
                                                            </td>
                                                            <td>
                                                                <%= notification.createdAt.toLocaleString() %>
                                                            </td>
                                                            <td>
                                                                <a href="#" class="text-info me-3 btn-view-notification" data-title="<%= notification.title %>" data-description="<%= notification.description %>" data-image="<%= notification.image || '' %>" data-sent-at="<%= notification.createdAt.toLocaleString() %>" data-bs-toggle="modal" data-bs-target="#viewNotificationModal"><i class="bx bx-show"></i></a>
                                                            </td>
                                                        </tr>
                                                    <% }); %>
                                        </tbody>
                                    </table>
                                </div>

                                <%- include('../partials/pagination', { currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, limit: limit }) %>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

<%- include('../layout/footer.ejs') %>

<div class="modal fade" id="viewNotificationModal" tabindex="-1" aria-labelledby="viewNotificationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewNotificationModalLabel">Notification Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3" id="viewNotifImageWrap" style="display:none;">
                    <img id="viewNotifImage" src="" alt="Notification Image" class="rounded modal-img-viewable" style="max-width: 100%; max-height: 200px; object-fit: cover;">
                </div>
                <table class="table table-borderless">
                    <tr><td class="fw-bold text-muted" style="width:100px;">Title</td><td id="viewNotifTitle"></td></tr>
                    <tr><td class="fw-bold text-muted">Description</td><td id="viewNotifDesc"></td></tr>
                    <tr><td class="fw-bold text-muted">Sent At</td><td id="viewNotifSentAt"></td></tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.btn-view-notification').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            var imgWrap = document.getElementById('viewNotifImageWrap');
            if (this.dataset.image) {
                document.getElementById('viewNotifImage').src = '/assets/userImages/' + this.dataset.image;
                imgWrap.style.display = '';
            } else {
                imgWrap.style.display = 'none';
            }
            document.getElementById('viewNotifTitle').textContent = this.dataset.title;
            document.getElementById('viewNotifDesc').innerHTML = this.dataset.description || '-';
            document.getElementById('viewNotifSentAt').textContent = this.dataset.sentAt;
        });
    });
</script>

<%- include('../partials/imageViewer') %>

<%- include('../layout/header.ejs') %>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <%- include('../layout/sidebar.ejs') %>
                <div class="content-wrapper">
                    <div class="container-xxl flex-grow-1 container-p-y">
                        <div class="row">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h4 class="py-3 mb-4">
                                        <span class="text-muted fw-light">Notification /</span> View Notifications
                                    </h4>
                                    <div class="btnwrap mb-4">
                                        <a href="/add-notification" class="btn btn-primary"><i class='bx bx-plus'></i>Send Notification</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-12 grid-margin stretch-card">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-hover" id="server-notification-table">
                                                <thead>
                                                    <tr>
                                                        <th>Sr No</th>
                                                        <th>Title</th>
                                                        <th>Description</th>
                                                        <th>Image</th>
                                                        <th>Sent At</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% notifications.forEach(function(notification, i){ %>
                                                        <tr>
                                                            <td class="align-center">
                                                                <strong><%= (currentPage - 1) * limit + i + 1 %></strong>
                                                            </td>
                                                            <td>
                                                                <strong><%= notification.title %></strong>
                                                            </td>
                                                            <td>
                                                                <%- notification.description %>
                                                            </td>
                                                            <td>
                                                                <% if (notification.image) { %>
                                                                    <img src="/assets/userImages/<%= notification.image %>" width="60" height="40" style="object-fit:cover;border-radius:6px;" />
                                                                <% } else { %>
                                                                    <span class="text-muted">-</span>
                                                                <% } %>
                                                            </td>
                                                            <td>
                                                                <%= notification.createdAt.toLocaleString() %>
                                                            </td>
                                                        </tr>
                                                    <% }); %>
                                        </tbody>
                                    </table>
                                </div>

                                <%- include('../partials/pagination', { currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, limit: limit }) %>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

<%- include('../layout/footer.ejs') %>

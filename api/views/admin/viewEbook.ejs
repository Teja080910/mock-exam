<%- include('../layout/header.ejs') %>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <%- include('../layout/sidebar.ejs') %>
                <div class="content-wrapper">
                    <div class="container-xxl flex-grow-1 container-p-y">
                        <div class="row">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h4 class="py-3 mb-4">
                                        <span class="text-muted fw-light">Ebook /</span> View Ebook
                                    </h4>
                                    <div class="btnwrap mb-4">
                                        <a href="/add-ebook" class="btn btn-primary"><i class='bx bx-plus'></i>Add New Ebook</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <div class="row">
                        <div class="col-lg-12 grid-margin stretch-card">
                            <div class="card mb-4">
                                <div class="card-header pb-0">
                                    <h5 class="card-title mb-0">Filter Ebooks</h5>
                                </div>
                                <div class="card-body pt-3">
                                    <form method="get" action="/view-ebook" id="ebookFilterForm">
                                        <div class="row g-3 align-items-center">
                                            <div class="col-md-3">
                                                <label class="form-label text-muted small fw-semibold">Language</label>
                                                <select name="language" id="filterLanguage" class="form-select text-capitalize" onchange="document.getElementById('ebookFilterForm').submit()">
                                                    <option value="">All Languages</option>
                                                    <% if (typeof languages !== 'undefined' && languages.length > 0) { %>
                                                        <% languages.forEach(function(lang){ %>
                                                            <option value="<%= lang %>" <%= typeof filters !== 'undefined' && filters.language === String(lang) ? 'selected' : '' %>><%= lang %></option>
                                                        <% }); %>
                                                    <% } %>
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label text-muted small fw-semibold">Status</label>
                                                <select name="is_active" class="form-select" onchange="document.getElementById('ebookFilterForm').submit()">
                                                    <option value="">All Status</option>
                                                    <option value="1" <%= typeof filters !== 'undefined' && filters.is_active === '1' ? 'selected' : '' %>>Enabled</option>
                                                    <option value="0" <%= typeof filters !== 'undefined' && filters.is_active === '0' ? 'selected' : '' %>>Disabled</option>
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label text-muted small fw-semibold">Search</label>
                                                <div class="input-group">
                                                    <input type="text" name="search" class="form-control" placeholder="Search ebook name..." value="<%= typeof filters !== 'undefined' ? filters.search : '' %>" />
                                                    <button type="submit" class="btn btn-primary"><i class="bx bx-search"></i></button>
                                                </div>
                                            </div>
                                            <div class="col-12 d-flex justify-content-end gap-2">
                                                <% if (typeof filters !== 'undefined' && (filters.language || filters.is_active !== '' || filters.search)) { %>
                                                    <a href="/view-ebook" class="btn btn-outline-secondary btn-sm"><i class="bx bx-x"></i> Clear Filters</a>
                                                <% } %>
                                                <button type="submit" class="btn btn-primary btn-sm"><i class="bx bx-filter-alt"></i> Apply Filter</button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12 grid-margin stretch-card">
                            <div class="card">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-hover" id="server-ebook-table">
                                            <thead>
                                                <tr>
                                                    <th>Sr No</th>
                                                    <th>Name</th>
                                                    <th>Language</th>
                                                    <th>Image</th>
                                                    <th>Link</th>
                                                    <th>is_Enable</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (ebook.length === 0) { %>
                                                    <tr>
                                                        <td colspan="7" class="text-center py-4 text-muted">
                                                            <i class="bx bx-info-circle fs-3 d-block mb-2"></i>
                                                            No ebooks found matching your filter criteria.
                                                        </td>
                                                    </tr>
                                                <% } %>
                                                <% ebook.forEach(function(allEbook, i){ %>
                                                    <tr>
                                                        <td class="align-center">
                                                            <strong><%= (currentPage - 1) * limit + i + 1 %></strong>
                                                        </td>
                                                        <td>
                                                            <strong><%= allEbook.name %></strong>
                                                        </td>
                                                        <td>
                                                            <strong><%= allEbook.language %></strong>
                                                        </td>
                                                        <td>
                                                            <img src="./assets/userImages/<%= allEbook.image %>" alt="Ebook Cover" style="max-width: 100px; height: auto;">
                                                        </td>
                                                        <td>
                                                            <% if (allEbook.file) { %>
                                                                <a href="./assets/userImages/<%= allEbook.file %>" target="_blank" class="btn btn-primary btn-sm">View PDF</a>
                                                            <% } %>
                                                            <% if (allEbook.link) { %>
                                                                <a href="<%= allEbook.link %>" target="_blank" class="btn btn-outline-primary btn-sm">Open Link</a>
                                                            <% } %>
                                                            <% if (!allEbook.file && !allEbook.link) { %>
                                                                <span class="text-muted">-</span>
                                                            <% } %>
                                                        </td>
                                                        <% const currentViewUrl = '/view-ebook?page=' + currentPage + (typeof extraParams !== 'undefined' ? extraParams : ''); %>
                                                        <% if (loginData.is_admin == 1) { %>
                                                            <td class="pe-0">
                                                                <form action="/ebook-is-active/<%= allEbook._id %>/toggle" id="featureForm" method="POST">
                                                                    <a id="toggleButton" >
                                                                        <div class="form-check form-switch mb-0">
                                                                            <input type="hidden" name="title" value="<%= allEbook.name %>"/>
                                                                            <input type="hidden" name="returnUrl" value="<%= currentViewUrl %>"/>
                                                                            <input class="form-check-input" type="checkbox" name="is_active" <% if(allEbook.is_active == 1) { %> checked <% }else{} %>>
                                                                        </div>
                                                                    </a>
                                                                </form>                   
                                                            </td>
                                                            <td>
                                                                <div class="d-flex gap-3">
                                                                    <a href="#" class="text-info me-3 btn-view-ebook" data-name="<%= allEbook.name %>" data-language="<%= allEbook.language %>" data-image="<%= allEbook.image %>" data-link="<%= allEbook.link %>" data-file="<%= allEbook.file || '' %>" data-is-active="<%= allEbook.is_active %>" data-bs-toggle="modal" data-bs-target="#viewEbookModal"><i class="bx bx-show"></i></a>
                                                                    <a href="/edit-ebook?id=<%= allEbook._id %>&returnUrl=<%= encodeURIComponent(currentViewUrl) %>" class="text-success me-3"><i class="bx bx-edit-alt"></i></a>
                                                                    <a href="/delete-ebook?id=<%= allEbook._id %>&returnUrl=<%= encodeURIComponent(currentViewUrl) %>" onclick="return confirm('Are you sure want to delete this <%= allEbook.name %>' )" class="text-danger me-3"><i class="bx bx-trash"></i></a>
                                                                </div>
                                                            </td>
                                                            <% } else { %>
                                                            <td>
                                                                <div class="form-check form-switch mb-0" onclick="alert('You have no access to change status..!!')">
                                                                    <input class="form-check-input" type="checkbox" name="is_active"  <% if(allEbook.is_active==1) { %> checked <% }else{} %>disabled>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="d-flex gap-3">
                                                                    <a href="#" class="text-info me-3 btn-view-ebook" data-name="<%= allEbook.name %>" data-language="<%= allEbook.language %>" data-image="<%= allEbook.image %>" data-link="<%= allEbook.link %>" data-file="<%= allEbook.file || '' %>" data-is-active="<%= allEbook.is_active %>" data-bs-toggle="modal" data-bs-target="#viewEbookModal"><i class="bx bx-show"></i></a>
                                                                    <a href="/edit-ebook?id=<%= allEbook._id %>&returnUrl=<%= encodeURIComponent(currentViewUrl) %>" class="text-success me-3"><i class="bx bx-edit-alt"></i></a>
                                                                    <a href="" onclick="return alert('You have no access to delete <%= allEbook.name %>.' )" class="text-danger"><i class="bx bx-trash"></i></a>
                                                                </div>
                                                            </td>
                                                            <%  }%>
                                                        </tr>
                                                    <% }); %>
                                                </tbody>
                                             </table>
                                         </div>

                                     <%- include('../partials/pagination', { currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, limit: limit, extraParams: typeof extraParams !== 'undefined' ? extraParams : '' }) %>

                                     </div>
                                 </div>
                                 </div>
                             </div>
                         </div>

                     </div>
                 </div>

<script type="text/javascript">
    const checkboxes = document.querySelectorAll('input[type="checkbox"]');
    
    checkboxes.forEach(function (checkbox) {
        checkbox.addEventListener('click', function (event) {
            const form = checkbox.closest('form');

            if (form) {
                const fieldName = form.querySelector('[name="title"]').value;

                const action = checkbox.checked ? 'Enable' : 'Disable';
                if (!confirm(`Are you sure you want to ${action} ${fieldName}?`)) {
                    event.preventDefault();
                    return;
                }

                const formData = new FormData(form);
                
                $.ajax({
                    type: "POST",
                    url: form.action,
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (data) {
                        console.log('Success:', data);
                    },
                    error: function (error) {
                        console.error('Error:', error);
                    }
                });
            }
        });
    });

    document.querySelectorAll('.btn-view-ebook').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            document.getElementById('viewEbookImage').src = './assets/userImages/' + this.dataset.image;
            document.getElementById('viewEbookName').textContent = this.dataset.name;
            document.getElementById('viewEbookLanguage').textContent = this.dataset.language;
            var link = this.dataset.link || '';
            document.getElementById('viewEbookLink').innerHTML = link ? '<a href="' + link + '" target="_blank">' + link + '</a>' : '-';
            var file = this.dataset.file || '';
            document.getElementById('viewEbookFile').innerHTML = file ? '<a href="./assets/userImages/' + file + '" target="_blank">' + file + '</a>' : '-';
            document.getElementById('viewEbookStatus').innerHTML = this.dataset.isActive == '1' ? '<span class="badge bg-success">Enabled</span>' : '<span class="badge bg-danger">Disabled</span>';
        });
    });
</script>

<div class="modal fade" id="viewEbookModal" tabindex="-1" aria-labelledby="viewEbookModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewEbookModalLabel">Ebook Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <img id="viewEbookImage" src="" alt="Ebook Cover" class="rounded modal-img-viewable" style="max-width: 150px; max-height: 200px; object-fit: cover;">
                </div>
                <table class="table table-borderless">
                    <tr><td class="fw-bold text-muted" style="width:120px;">Name</td><td id="viewEbookName"></td></tr>
                    <tr><td class="fw-bold text-muted">Language</td><td id="viewEbookLanguage"></td></tr>
                    <tr><td class="fw-bold text-muted">Link</td><td id="viewEbookLink"></td></tr>
                    <tr><td class="fw-bold text-muted">File</td><td id="viewEbookFile"></td></tr>
                    <tr><td class="fw-bold text-muted">Status</td><td id="viewEbookStatus"></td></tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/imageViewer') %>

<%- include('../layout/footer.ejs') %>

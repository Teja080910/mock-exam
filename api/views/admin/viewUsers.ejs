<%- include('../layout/header.ejs') %>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <%- include('../layout/sidebar.ejs') %>
                <div class="container-xxl flex-grow-1 container-p-y">
                    <h4 class="py-3 mb-4">
                        <span class="text-muted fw-light">Users /</span> All Users
                    </h4>
                    <div class="row">
                        <div class="col-lg-12 grid-margin stretch-card">
                            <div class="card mb-4">
                                <div class="card-header pb-0">
                                    <h5 class="card-title mb-0">Filter Users</h5>
                                </div>
                                <div class="card-body pt-3">
                                    <form method="get" action="/view-users" id="userFilterForm">
                                        <div class="row g-3 align-items-center">
                                            <div class="col-md-3">
                                                <label class="form-label text-muted small fw-semibold">Status</label>
                                                <select name="active" class="form-select" onchange="document.getElementById('userFilterForm').submit()">
                                                    <option value="">All Status</option>
                                                    <option value="1" <%= typeof filters !== 'undefined' && (filters.active === '1' || filters.active === 'true' || filters.active === true) ? 'selected' : '' %>>Active</option>
                                                    <option value="0" <%= typeof filters !== 'undefined' && (filters.active === '0' || filters.active === 'false' || filters.active === false) ? 'selected' : '' %>>Deactivated</option>
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label text-muted small fw-semibold">Verification</label>
                                                <select name="is_verified" class="form-select" onchange="document.getElementById('userFilterForm').submit()">
                                                    <option value="">All Verification</option>
                                                    <option value="1" <%= typeof filters !== 'undefined' && filters.is_verified === '1' ? 'selected' : '' %>>Verified</option>
                                                    <option value="0" <%= typeof filters !== 'undefined' && filters.is_verified === '0' ? 'selected' : '' %>>Unverified</option>
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label text-muted small fw-semibold">Search</label>
                                                <div class="input-group">
                                                    <input type="text" name="search" class="form-control" placeholder="Search by name, email, phone, referral code..." value="<%= typeof filters !== 'undefined' ? filters.search : '' %>" />
                                                    <button type="submit" class="btn btn-primary"><i class="bx bx-search"></i></button>
                                                </div>
                                            </div>
                                            <div class="col-12 d-flex justify-content-end gap-2">
                                                <% if (typeof filters !== 'undefined' && (filters.active !== '' || filters.is_verified !== '' || filters.search)) { %>
                                                    <a href="/view-users" class="btn btn-outline-secondary btn-sm"><i class="bx bx-x"></i> Clear Filters</a>
                                                <% } %>
                                                <button type="submit" class="btn btn-primary btn-sm"><i class="bx bx-filter-alt"></i> Apply Filter</button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12 grid-margin stretch-card">
                            <div class="card">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-hover" id="server-users-table">
                                            <thead>
                                                <tr>
                                                    <th>Sr No.</th>
                                                    <th>Image</th>
                                                    <th>Name</th>
                                                    <th>Email</th>
                                                    <th>Phone</th>
                                                    <th>Points</th>
                                                    <th>Referral Code</th>
                                                    <th>Referred By</th>
                                                    <th>Verify</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (users.length === 0) { %>
                                                    <tr>
                                                        <td colspan="10" class="text-center py-4 text-muted">
                                                            <i class="bx bx-info-circle fs-3 d-block mb-2"></i>
                                                            No users found matching your filter criteria.
                                                        </td>
                                                    </tr>
                                                <% } %>
                                                <% if(users.length> 0) {
                                                    for(let i=0; i < users.length; i++) { %>
                                                        <tr>
                                                            <td><%= (currentPage - 1) * limit + i + 1 %></td>
                                                            <td>
                                                                <ul class="list-unstyled users-list m-0 avatar-group d-flex align-items-center">
                                                                    <li data-bs-toggle="tooltip" data-popup="tooltip-custom" data-bs-placement="top" class="avatar def-avatar avatar-xs pull-up" title="<%= users[i].username %>"data-bs-original-title="">
                                                                        
                                                                        <% if(users[i].image) { %>
                                                                                <img src="./assets/userImages/<%= users[i].image %>" alt="<%= users[i].username %>" class="rounded-circle">
                                                                        <% } else { %>
                                                                            <div class="text-wrap">
                                                                                <div class="fs-5 bg-gray text-white rounded-circle text-center" style="width:30px;height:30px;"><%= users[i].username.charAt(0); %></div>
                                                                            </div>
                                                                        <% } %>
                                                                    </li>
                                                                </ul>
                                                            </td>
                                                            <td>
                                                                <strong><%= users[i].username %></strong>
                                                            </td>
                                                            <td>
                                                                <%= users[i].email %>
                                                            </td>
                                                            <td>
                                                                <%= users[i].phone %>
                                                            </td>
                                                            <td>
                                                                <strong><%= users[i].points %></strong>
                                                            </td>
                                                            <td>
                                                                <%= users[i].referral_code ? users[i].referral_code : '-' %>
                                                            </td>
                                                            <td>
                                                                <% if (users[i].referred_by && users[i].referred_by.username) { %>
                                                                    <%= users[i].referred_by.username %>
                                                                <% } else { %>
                                                                    -
                                                                <% } %>
                                                            </td>
                                                            <td>
                                                                <% if (users[i].is_verified=="1" ) { %>
                                                                    <span class="text-primary">Yes</span>
                                                                    <% } else { %>
                                                                        <span class="text-danger">No</span>
                                                                <% } %>
                                                            </td>
                                                            <td>
                                                                <% if(loginData.is_admin==1) { %>
                                                                    <a href="#" class="text-info me-2 btn-view-user" data-username="<%= users[i].username %>" data-email="<%= users[i].email %>" data-phone="<%= users[i].phone %>" data-points="<%= users[i].points %>" data-referral-code="<%= users[i].referral_code || '-' %>" data-referred-by="<%= (users[i].referred_by && users[i].referred_by.username) ? users[i].referred_by.username : '-' %>" data-is-verified="<%= users[i].is_verified %>" data-active="<%= users[i].active %>" data-image="<%= users[i].image || '' %>" data-bs-toggle="modal" data-bs-target="#viewUserModal"><i class="bx bx-show"></i></a>
                                                                    <form class="toggle-form" data-user-id="<%= users[i]._id %>"data-action="/view-users/<%= users[i]._id %>/toggle" method="POST">
                                                                        <button type="button" class="btn <%= users[i].active ? 'btn-primary' : 'btn-danger' %> toggle-button2"
                                                                            data-user-active="<%= users[i].active ? 'Active' : 'Deactivate' %>"
                                                                            data-user-username="<%= users[i].username %>">
                                                                            <%= users[i].active ? 'Active' : 'Deactivate' %>
                                                                        </button>
                                                                    </form>
                                                                <% } else { %>
                                                                    <a href="#" class="text-info me-2 btn-view-user" data-username="<%= users[i].username %>" data-email="<%= users[i].email %>" data-phone="<%= users[i].phone %>" data-points="<%= users[i].points %>" data-referral-code="<%= users[i].referral_code || '-' %>" data-referred-by="<%= (users[i].referred_by && users[i].referred_by.username) ? users[i].referred_by.username : '-' %>" data-is-verified="<%= users[i].is_verified %>" data-active="<%= users[i].active %>" data-image="<%= users[i].image || '' %>" data-bs-toggle="modal" data-bs-target="#viewUserModal"><i class="bx bx-show"></i></a>
                                                                    <button type="" class="btn <%= users[i].active ? 'btn-primary' : 'btn-danger' %>"
                                                                        onclick="return alert(`You have no access to edit <%= users[i].username %>.` )">
                                                                        <%= users[i].active ? 'Active'
                                                                            : 'Deactive' %>
                                                                    </button>
                                                                <% } } }%>
                                                            </td>
                                                        </tr>
                                                    <tbody>
                                                </table>
                                            </div>

                                            <%- include('../partials/pagination', { currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, limit: limit, extraParams: typeof extraParams !== 'undefined' ? extraParams : '' }) %>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script type="text/javascript">
    jQuery(document).ready(function () {
        jQuery('.toggle-button2').on('click', function (e) {
            e.preventDefault(); // Prevent the default form submission
            const form = jQuery(this).closest('form');
            const userId = form.data('user-id');
            const action = form.data('action');
            const userActive = form.find('.toggle-button2').hasClass('btn-primary');
            var username = $(this).data('user-username');

            let confirmationMessage;

            if (userActive) {
                confirmationMessage = `Are you sure you want to Deactivate ${username} ?`;
            } else {
                confirmationMessage = `Are you sure you want to Activate ${username} ?`;
            }

            if (confirm(confirmationMessage)) {
                jQuery.ajax({
                    type: "POST",
                    url: action,
                    data: { userId: userId },
                    dataType: "json",
                    success: function (data) {
                        if (data.success === 1) {
                            if (data.active) {
                                form.find('.toggle-button2')
                                    .removeClass('btn-danger')
                                    .addClass('btn-primary')
                                    .text('Active');
                            } else {
                                form.find('.toggle-button2')
                                    .removeClass('btn-primary')
                                    .addClass('btn-danger')
                                    .text('Deactivate');
                            }
                        }
                    },
                    error: function (error) {
                        console.error('Error:', error);
                    }
                });
            }
        });
    });
</script>

<div class="modal fade" id="viewUserModal" tabindex="-1" aria-labelledby="viewUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewUserModalLabel">User Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <div id="viewUserAvatar" class="rounded-circle d-inline-flex align-items-center justify-content-center modal-img-viewable" style="width: 80px; height: 80px; background: #6c757d; color: #fff; font-size: 28px;"></div>
                </div>
                <table class="table table-borderless">
                    <tr><td class="fw-bold text-muted" style="width:130px;">Name</td><td id="viewUserName"></td></tr>
                    <tr><td class="fw-bold text-muted">Email</td><td id="viewUserEmail"></td></tr>
                    <tr><td class="fw-bold text-muted">Phone</td><td id="viewUserPhone"></td></tr>
                    <tr><td class="fw-bold text-muted">Points</td><td id="viewUserPoints"></td></tr>
                    <tr><td class="fw-bold text-muted">Referral Code</td><td id="viewUserReferral"></td></tr>
                    <tr><td class="fw-bold text-muted">Referred By</td><td id="viewUserReferredBy"></td></tr>
                    <tr><td class="fw-bold text-muted">Verified</td><td id="viewUserVerified"></td></tr>
                    <tr><td class="fw-bold text-muted">Status</td><td id="viewUserStatus"></td></tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.btn-view-user').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            var avatar = document.getElementById('viewUserAvatar');
            if (this.dataset.image) {
                avatar.innerHTML = '<img src="./assets/userImages/' + this.dataset.image + '" style="width:80px;height:80px;border-radius:50%;object-fit:cover;" />';
                avatar.style.background = 'transparent';
                var loadedImg = avatar.querySelector('img');
                if (loadedImg) {
                    loadedImg.classList.add('modal-img-viewable');
                    loadedImg.style.cursor = 'zoom-in';
                    loadedImg.addEventListener('click', function(ev) {
                        ev.stopPropagation();
                        var overlay = document.getElementById('imageViewerOverlay');
                        var viewerImg = document.getElementById('imageViewerImg');
                        viewerImg.src = this.src;
                        overlay.classList.add('show');
                    });
                }
            } else {
                avatar.textContent = this.dataset.username.charAt(0).toUpperCase();
                avatar.style.background = '#6c757d';
            }
            document.getElementById('viewUserName').textContent = this.dataset.username;
            document.getElementById('viewUserEmail').textContent = this.dataset.email;
            document.getElementById('viewUserPhone').textContent = this.dataset.phone;
            document.getElementById('viewUserPoints').textContent = this.dataset.points;
            document.getElementById('viewUserReferral').textContent = this.dataset.referralCode;
            document.getElementById('viewUserReferredBy').textContent = this.dataset.referredBy;
            document.getElementById('viewUserVerified').innerHTML = this.dataset.isVerified == '1' ? '<span class="badge bg-success">Yes</span>' : '<span class="badge bg-danger">No</span>';
            document.getElementById('viewUserStatus').innerHTML = this.dataset.active == 'true' || this.dataset.active == '1' ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-danger">Inactive</span>';
        });
    });
</script>

<%- include('../partials/imageViewer') %>


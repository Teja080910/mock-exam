<%- include('../layout/header.ejs') %>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <%- include('../layout/sidebar.ejs') %>
                <div class="content-wrapper">
                    <div class="container-xxl flex-grow-1 container-p-y">
                        <div class="row">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h4 class="py-3 mb-4">
                                        <span class="text-muted fw-light">Category /</span> View Category
                                    </h4>
                                    <div class="btnwrap mb-4">
                                        <a href="/add-category" class="btn btn-primary"><i class='bx bx-plus'></i>Add New Category</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-12 grid-margin stretch-card">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-hover" id="server-category-table">
                                                <thead>
                                                    <tr>
                                                        <th>Sr No</th>
                                                        <th>Image</th>
                                                        <th>Title</th>
                                                        <th>Quiz Count</th>
                                                        <th>is_Enable</th>
                                                        <th>is_feature</th>
                                                        <th>Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% category.forEach(function(allCategory, i){ %>
                                                        <tr>
                                                            <td class="align-center">
                                                                <strong><%= (currentPage - 1) * limit + i + 1 %></strong>
                                                            </td>
                                                            <td>
                                                                <ul class="list-unstyled users-list m-0 avatar-group d-flex align-items-center">
                                                                    <li data-bs-toggle="tooltip" data-popup="tooltip-custom" data-bs-placement="top" class="avatar def-avatar avatar-xs pull-up" title="<%= allCategory.title %>" data-bs-original-title="">
                                                                        <img src="./assets/userImages/<%= allCategory.image %>" alt="Avatar" class="rounded-circle">
                                                                    </li>
                                                                </ul>
                                                            </td>
                                                            <td>
                                                                <strong><%= allCategory.name %></strong>
                                                            </td>
                                                            <td>
                                                                <strong>
                                                                    <% if (quiz.length > 0) {
                                                                        let count = 0;
                                                                        for (let j = 0; j < quiz.length; j++) { 
                                                                            if (quiz[j].categoryId && String(allCategory._id) === String(quiz[j].categoryId._id)) { 
                                                                                count++;
                                                                            } } %>
                                                                        <%= count %>
                                                                    <% } %>
                                                                <strong>
                                                            </td>
                                                            <% if (loginData.is_admin == 1) { %>
                                                                <td class="pe-0">
                                                                    <form action="/category-is-active/<%= allCategory._id %>/toggle" id="featureForm" method="POST">
                                                                        <a id="toggleButton" >
                                                                            <div class="form-check form-switch mb-0">
                                                                                <input type="hidden" name="title" value="<%= allCategory.title %>"/>
                                                                                <input class="form-check-input" type="checkbox" name="is_active" <% if(allCategory.is_active == 1) { %> checked <% }else{} %>>
                                                                            </div>
                                                                        </a>
                                                                    </form>                   
                                                                </td>
                                                                <td>
                                                                    <form action="/update-is-feature/<%= allCategory._id %>/toggle" id="featureForm2" method="POST">
                                                                        <button type="button" class="btn" id="toggleButton" >
                                                                            <div class="form-check form-switch mb-2">
                                                                                <input type="hidden" name="title" value="<%= allCategory.name%>"/>
                                                                                <input class="form-check-input" type="checkbox" name="is_feature" <% if(allCategory.is_feature==1) { %> checked <% }else{} %>>
                                                                            </div>
                                                                        </button>
                                                                    </form>
                                                                </td>
                                                                <td>
                                                                    <div class="d-flex gap-3">
                                                                        <a href="#" class="text-info me-3 btn-view-category" data-id="<%= allCategory._id %>" data-name="<%= allCategory.name %>" data-image="<%= allCategory.image %>" data-is-active="<%= allCategory.is_active %>" data-is-feature="<%= allCategory.is_feature %>" data-quiz-count="<% if (quiz.length > 0) { let count = 0; for (let j = 0; j < quiz.length; j++) { if (quiz[j].categoryId && String(allCategory._id) === String(quiz[j].categoryId._id)) { count++; } } %><%= count %><% } else { %>0<% } %>" data-bs-toggle="modal" data-bs-target="#viewCategoryModal"><i class="bx bx-show"></i></a>
                                                                        <a href="/edit-category?id=<%= allCategory._id %>"class="text-success me-3"><i class="bx bx-edit-alt"></i></a>
                                                                        <a href="/delete-category?id=<%= allCategory._id %>" onclick="return confirm('Are you sure want to delete this <%= allCategory.name %>' )" class="text-danger me-3"><i class="bx bx-trash"></i></a>
                                                                    </div>
                                                                </td>
                                                                <% } else { %>
                                                                <td>
                                                                    <div class="form-check form-switch mb-0" onclick="alert('You have no access to change status..!!')">
                                                                        <input class="form-check-input" type="checkbox" name="is_active"  <% if(allCategory.is_active==1) { %> checked <% }else{} %>disabled>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="form-check form-switch mb-2" onclick="return alert('You have no access to Enable or Disable.' )">
                                                                        <input class="form-check-input" type="checkbox" name="is_feature" <% if(allCategory.is_feature==1) { %> checked <% }else{} %> disabled>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="d-flex gap-3">
                                                                        <a href="#" class="text-info me-3 btn-view-category" data-id="<%= allCategory._id %>" data-name="<%= allCategory.name %>" data-image="<%= allCategory.image %>" data-is-active="<%= allCategory.is_active %>" data-is-feature="<%= allCategory.is_feature %>" data-bs-toggle="modal" data-bs-target="#viewCategoryModal"><i class="bx bx-show"></i></a>
                                                                        <a href="/edit-category?id=<%= allCategory._id %>" class="text-success me-3"><i class="bx bx-edit-alt"></i></a>
                                                                        <a href="" onclick="return alert('You have no access to delete <%= allCategory.name %> category.' )" class="text-danger"><i class="bx bx-trash"></i></a>
                                                                    </div>
                                                                </td>
                                                                <%  }%>
                                                            </tr>
                                                        <% }); %>
                                                    </tbody>
                                                 </table>
                                             </div>

                                         <%- include('../partials/pagination', { currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, limit: limit }) %>

                                         </div>
                                     </div>
                                 </div>
                             </div>
                         </div>

                     </div>
                 </div>

<script type="text/javascript">
    const checkboxes = document.querySelectorAll('input[type="checkbox"]');
    
    checkboxes.forEach(function (checkbox) {
        checkbox.addEventListener('click', function (event) {
            const form = checkbox.closest('form');  // Get the closest form element related to the checkbox

            if (form) {
                const fieldName = form.querySelector('[name="title"]').value;  // Get the name or title value

                // Prompt the user for confirmation based on the checkbox action
                const action = checkbox.checked ? 'Enable' : 'Disable';
                if (!confirm(`Are you sure you want to ${action} ${fieldName}?`)) {
                    // Prevent checkbox from changing its checked state if cancelled
                    event.preventDefault();
                    return;
                }

                // Prepare FormData for AJAX request
                const formData = new FormData(form);
                
                // Send the AJAX POST request
                $.ajax({
                    type: "POST",
                    url: form.action,  // Use the form action URL dynamically
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (data) {
                        console.log('Success:', data);  // Log success response
                    },
                    error: function (error) {
                        console.error('Error:', error);  // Log any errors
                    }
                });
            }
        });
    });
</script>

<div class="modal fade" id="viewCategoryModal" tabindex="-1" aria-labelledby="viewCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewCategoryModalLabel">Category Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <img id="viewCategoryImage" src="" alt="Category Image" class="rounded-circle modal-img-viewable" style="width: 80px; height: 80px; object-fit: cover;">
                </div>
                <table class="table table-borderless">
                    <tr><td class="fw-bold text-muted" style="width:140px;">Name</td><td id="viewCategoryName"></td></tr>
                    <tr><td class="fw-bold text-muted">Quiz Count</td><td id="viewCategoryQuizCount"></td></tr>
                    <tr><td class="fw-bold text-muted">Status</td><td id="viewCategoryStatus"></td></tr>
                    <tr><td class="fw-bold text-muted">Featured</td><td id="viewCategoryFeature"></td></tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.btn-view-category').forEach(function(btn) {
        btn.addEventListener('click', function() {
            document.getElementById('viewCategoryImage').src = './assets/userImages/' + this.dataset.image;
            document.getElementById('viewCategoryName').textContent = this.dataset.name;
            document.getElementById('viewCategoryQuizCount').textContent = this.dataset.quizCount || '0';
            document.getElementById('viewCategoryStatus').innerHTML = this.dataset.isActive == '1' ? '<span class="badge bg-success">Enabled</span>' : '<span class="badge bg-danger">Disabled</span>';
            document.getElementById('viewCategoryFeature').innerHTML = this.dataset.isFeature == '1' ? '<span class="badge bg-success">Yes</span>' : '<span class="badge bg-secondary">No</span>';
        });
    });
</script>

<%- include('../partials/imageViewer') %>

<%- include('../layout/footer.ejs') %>

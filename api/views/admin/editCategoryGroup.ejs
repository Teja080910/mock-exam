<%- include('../layout/header.ejs') %>
<div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">
        <%- include('../layout/sidebar.ejs') %>
        <div class="content-wrapper">
            <div class="container-xxl flex-grow-1 container-p-y">
                <div class="row">
                    <div class="col-md-6">
                        <h4 class="py-3 mb-4">
                            <span class="text-muted fw-light">Category Group /</span> Edit Category Group
                        </h4>
                        <div class="card mb-4">
                            <form action="/edit-category-group" method="post" enctype="multipart/form-data">
                                <div class="card-body">
                                    <input type="hidden" name="id" value="<%= group._id %>" />
                                    <div class="row mb-3">
                                        <label class="col-sm-3 col-form-label" for="displayName">Display Name</label>
                                        <div class="col-sm-9">
                                            <input type="text" class="form-control" name="displayName" value="<%= group.displayName %>" placeholder="Enter Group Display Name" required />
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <label class="col-sm-3 col-form-label" for="code">Short Code</label>
                                        <div class="col-sm-9">
                                            <input type="text" class="form-control" name="code" value="<%= group.code || '' %>" placeholder="e.g. RRB, SSC, UPSC" />
                                            <small class="form-text text-muted">Short label shown on the app home screen (e.g. RRB, SSC, IBPS).</small>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <label class="col-sm-3 col-form-label" for="image">Group Image</label>
                                        <div class="col-sm-9">
                                            <% if (group.image) { %>
                                                <div class="mb-2">
                                                    <img src="/assets/userImages/<%= group.image %>" alt="Current Image" style="max-width: 80px; max-height: 80px; border-radius: 8px; border: 1px solid #ddd;" />
                                                </div>
                                            <% } %>
                                            <input type="file" class="form-control" name="image" accept="image/*" />
                                            <small class="form-text text-muted">Upload a new image to replace the current one.</small>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <label class="col-sm-3 col-form-label" for="scope">Scope</label>
                                        <div class="col-sm-9">
                                            <% var currentScope = (group.scope && ['central','state','none'].indexOf(group.scope) !== -1) ? group.scope : 'none'; %>
                                            <select class="form-select" name="scope" id="scope">
                                                <option value="central" <%= currentScope === 'central' ? 'selected' : '' %>>Central wise</option>
                                                <option value="state" <%= currentScope === 'state' ? 'selected' : '' %>>State wise</option>
                                                <option value="none" <%= currentScope === 'none' ? 'selected' : '' %>>None</option>
                                            </select>
                                            <small class="form-text text-muted">Use "Central wise" / "State wise" to group exams on the app home screen.</small>
                                        </div>
                                    </div>
                                    <div class="row mb-3">
                                        <label class="col-sm-3 col-form-label" for="categories">Categories</label>
                                        <div class="col-sm-9">
                                            <div id="selectedChips" style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px;min-height:32px;"></div>
                                            <div id="categoryList" style="border:1px solid #ddd;border-radius:8px;padding:8px;max-height:200px;overflow-y:auto;background:#fafafa;">
                                                <% categories.forEach(function(cat) { %>
                                                    <div class="cat-item" data-id="<%= cat._id %>" data-name="<%= cat.displayName || cat.name %>" style="display:flex;align-items:center;padding:8px 12px;cursor:pointer;border-radius:6px;margin-bottom:4px;background:#fff;border:1px solid #e5e7eb;transition:all 0.15s;">
                                                        <i class="bx bx-plus-circle" style="margin-right:8px;color:#2563EB;font-size:18px;"></i>
                                                        <span><%= cat.displayName || cat.name %></span>
                                                    </div>
                                                <% }) %>
                                            </div>
                                            <input type="hidden" name="categories" id="categoriesHidden" value="<%= group.categories.map(function(c){ return c._id; }).join(',') %>">
                                        </div>
                                    </div>
                                            <input type="hidden" name="categories" id="categoriesHidden" value="<%= group.categories.map(function(c){ return c._id; }).join(',') %>">
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-3"></div>
                                        <div class="col-sm-9">
                                            <button type="submit" class="btn btn-primary">Save</button>
                                            <a href="/view-category-groups" class="ms-3 btn btn-dark">Back</a>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <%- include('../layout/footer.ejs') %>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const chipsContainer = document.getElementById('selectedChips');
    const categoryList = document.getElementById('categoryList');
    const hiddenInput = document.getElementById('categoriesHidden');
    let selectedIds = hiddenInput.value ? hiddenInput.value.split(',').filter(Boolean) : [];

    function updateHidden() { hiddenInput.value = selectedIds.join(','); }

    function renderChips() {
        chipsContainer.innerHTML = '';
        selectedIds.forEach(function(id) {
            const item = categoryList.querySelector('[data-id="' + id + '"]');
            if (!item) return;
            const name = item.getAttribute('data-name');
            const chip = document.createElement('span');
            chip.style.cssText = 'display:inline-flex;align-items:center;gap:4px;padding:4px 10px;background:#e0e7ff;color:#1e40af;border-radius:16px;font-size:13px;font-weight:500;';
            chip.innerHTML = name + ' <i class="bx bx-x" style="cursor:pointer;font-size:16px;"></i>';
            chip.querySelector('i').addEventListener('click', function() {
                selectedIds = selectedIds.filter(x => x !== id);
                item.style.display = '';
                item.querySelector('i').className = 'bx bx-plus-circle';
                renderChips();
                updateHidden();
            });
            chipsContainer.appendChild(chip);
        });
    }

    categoryList.querySelectorAll('.cat-item').forEach(function(item) {
        const id = item.getAttribute('data-id');
        item.addEventListener('click', function() {
            const cid = this.getAttribute('data-id');
            if (selectedIds.includes(cid)) return;
            selectedIds.push(cid);
            this.style.display = 'none';
            renderChips();
            updateHidden();
        });
        if (selectedIds.includes(id)) item.style.display = 'none';
    });

    renderChips();
    updateHidden();
});
</script>
        </div>
    </div>
</div> 
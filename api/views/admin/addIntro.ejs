<%- include('../layout/header.ejs') %>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <%- include('../layout/sidebar.ejs') %>
            <div class="content-wrapper">
                <div class="container-xxl flex-grow-1 container-p-y">
                    <div class="row">
                        <div class="col-md-8">
                            <h4 class="py-3 mb-4">
                                <span class="text-muted fw-light">Offers /</span> Add Offer
                              </h4>
                            <div class="card mb-4 h-px-480">
                                <form action="" method="post" enctype="multipart/form-data">
                                    <div class="card-body">
                                        <% if(typeof message !== 'undefined'){ %>
                                            <div class="alert alert-primary alert-dismissible" role="alert"><%= message %>
                                             <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                            </div>
                                         <% } %>
                                         <% if(flash.error.length> 0){ %>
                                            <div class="alert alert-danger alert-dismissible" role="alert">
                                                <%= flash.error %>
                                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                            </div>
                                        <% } %>
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="row mb-3">
                                                    <label class="col-sm-2 col-form-label"
                                                        for="basic-icon-default-fullname">Title</label>
                                                    <div class="col-sm-10">
                                                        <div class="input-group input-group-merge">
                                                            <input type="text" class="form-control" name="title" value="" placeholder="Enter Title" pattern="^[A-Za-z0-9 ]+$" required />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row mb-3">
                                                    <label class="col-sm-2 col-form-label"
                                                        for="basic-icon-default-fullname">Image</label>
                                                    <div class="col-sm-10">
                                                        <div class="input-group input-group-merge">
                                                            <span id="basic-icon-default-fullname2" class="input-group-text">
                                                                <i class="bx bx-image"></i>
                                                            </span>
                                                            <input type="file" id="upload" name="image" class="form-control" accept="image/png, image/jpeg,image/jpg" required/>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <label class="col-sm-2 col-form-label" for="basic-icon-default-fullname">is Active</label>
                                                    <div class="col-sm-10">
                                                        <div class="form-check form-switch mb-2">
                                                            <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" name="is_active" checked>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-sm-2">
                                                        <label class="col-form-label"for="basic-icon-default-fullname">Description</label>
                                                    </div>
                                                    <div class="col-sm-10">
                                                        <div id="description"></div>
                                                        <input name="description" type="hidden">
                                                    </div>
                                                </div>
                                                    <div class="row mb-3">
                                                        <label class="col-sm-2 col-form-label">Plan Discounts</label>
                                                        <div class="col-sm-10">
                                                            <div class="border rounded p-3">
                                                                <div class="text-muted small mb-3">While this offer is the newest active one, these discounts are shown on the app's subscription page.</div>
                                                                <% (typeof plans !== 'undefined' ? plans : []).forEach(function(plan){ %>
                                                                    <% var disc = (typeof intro !== 'undefined' && intro && intro.discounts ? intro.discounts : []).find(function(x){ return String(x.planId) === String(plan._id); }); %>
                                                                    <% var pct = disc ? disc.discountPercent : 0; %>
                                                                    <div class="d-flex align-items-center gap-3 mb-2">
                                                                        <div class="form-check form-switch mb-0">
                                                                            <input class="form-check-input" type="checkbox" name="plan_enable_<%= plan._id %>" <%= pct > 0 ? 'checked' : '' %>>
                                                                        </div>
                                                                        <div style="min-width: 220px;">
                                                                            <strong><%= plan.planName %></strong>
                                                                            <span class="text-muted small">(Rs. <%= plan.price %>)</span>
                                                                        </div>
                                                                        <div class="input-group" style="max-width: 170px;">
                                                                            <input type="number" min="0" max="100" step="1" class="form-control" name="plan_discount_<%= plan._id %>" value="<%= pct > 0 ? pct : '' %>" placeholder="0">
                                                                            <span class="input-group-text">% off</span>
                                                                        </div>
                                                                    </div>
                                                                <% }); %>
                                                                <% if (typeof plans === 'undefined' || plans.length === 0) { %>
                                                                    <div class="text-muted small">No plans found.</div>
                                                                <% } %>
                                                            </div>
                                                        </div>
                                                    </div>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="row mb-4">
                                        <div class="col-sm-2"></div>
                                        <div class="col-sm-10">
                                            <button type="submit" class="btn btn-primary" onclick="myFunction();">Submit</button>
                                            <a href="/view-intro" class="ms-3 btn btn-dark">Back</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
<%- include('../layout/footer.ejs') %>


           

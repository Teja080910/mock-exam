<%- include('../layout/header.ejs') %>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <%- include('../layout/sidebar.ejs') %>
                <div class="content-wrapper">
                    <div class="container-xxl flex-grow-1 container-p-y">
                        <div class="row">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h4 class="py-3 mb-4">
                                        <span class="text-muted fw-light">News /</span> View News
                                    </h4>
                                    <div class="btnwrap mb-4">
                                        <a href="/add-news" class="btn btn-primary"><i class='bx bx-plus'></i>Add New Post</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <div class="row">
                        <div class="col-lg-12 grid-margin stretch-card">
                            <div class="card mb-4">
                                <div class="card-header pb-0">
                                    <h5 class="card-title mb-0">Filter News</h5>
                                </div>
                                <div class="card-body pt-3">
                                    <form method="get" action="/view-news" id="newsFilterForm">
                                        <div class="row g-3 align-items-center">
                                            <div class="col-md-3">
                                                <label class="form-label text-muted small fw-semibold">Type</label>
                                                <select name="post_type" class="form-select" onchange="document.getElementById('newsFilterForm').submit()">
                                                    <option value="">All Types</option>
                                                    <option value="notification" <%= typeof filters !== 'undefined' && filters.post_type === 'notification' ? 'selected' : '' %>>Notification</option>
                                                    <option value="result" <%= typeof filters !== 'undefined' && filters.post_type === 'result' ? 'selected' : '' %>>Result</option>
                                                    <option value="admit_card" <%= typeof filters !== 'undefined' && filters.post_type === 'admit_card' ? 'selected' : '' %>>Admit Card</option>
                                                    <option value="answer_key" <%= typeof filters !== 'undefined' && filters.post_type === 'answer_key' ? 'selected' : '' %>>Answer Key</option>
                                                    <option value="other" <%= typeof filters !== 'undefined' && filters.post_type === 'other' ? 'selected' : '' %>>Other</option>
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label text-muted small fw-semibold">Status</label>
                                                <select name="is_active" class="form-select" onchange="document.getElementById('newsFilterForm').submit()">
                                                    <option value="">All Status</option>
                                                    <option value="1" <%= typeof filters !== 'undefined' && filters.is_active === '1' ? 'selected' : '' %>>Enabled</option>
                                                    <option value="0" <%= typeof filters !== 'undefined' && filters.is_active === '0' ? 'selected' : '' %>>Disabled</option>
                                                </select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label text-muted small fw-semibold">Search</label>
                                                <div class="input-group">
                                                    <input type="text" name="search" class="form-control" placeholder="Search news title or description..." value="<%= typeof filters !== 'undefined' ? filters.search : '' %>" />
                                                    <button type="submit" class="btn btn-primary"><i class="bx bx-search"></i></button>
                                                </div>
                                            </div>
                                            <div class="col-12 d-flex justify-content-end gap-2">
                                                <% if (typeof filters !== 'undefined' && (filters.post_type || filters.is_active !== '' || filters.search)) { %>
                                                    <a href="/view-news" class="btn btn-outline-secondary btn-sm"><i class="bx bx-x"></i> Clear Filters</a>
                                                <% } %>
                                                <button type="submit" class="btn btn-primary btn-sm"><i class="bx bx-filter-alt"></i> Apply Filter</button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12 grid-margin stretch-card">
                            <div class="card">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-hover" id="server-news-table">
                                            <thead>
                                                <tr>
                                                    <th>Sr No</th>
                                                    <th>Type</th>
                                                    <th>Title</th>
                                                    <th>Description</th>
                                                    <th>Link</th>
                                                    <th>Status</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (news.length === 0) { %>
                                                    <tr>
                                                        <td colspan="7" class="text-center py-4 text-muted">
                                                            <i class="bx bx-info-circle fs-3 d-block mb-2"></i>
                                                            No news items found matching your filter criteria.
                                                        </td>
                                                    </tr>
                                                <% } %>
                                                <% const currentViewUrl = '/view-news?page=' + currentPage + (typeof extraParams !== 'undefined' ? extraParams : ''); %>
                                                <% const typeLabels={ result: 'Result' , admit_card: 'Admit Card' , answer_key: 'Answer Key' , notification: 'Notification' , other: 'Other' }; const typeBadgeColors={ result: 'bg-success' , admit_card: 'bg-warning text-dark' , answer_key: 'bg-info text-dark' , notification: 'bg-primary' , other: 'bg-secondary' }; %>
                                                <% news.forEach(function(allNews, i){ %>
                                                    <tr>
                                                        <td class="align-center">
                                                            <strong><%= (currentPage - 1) * limit + i + 1 %></strong>
                                                        </td>
                                                        <td>
                                                            <% const pt = allNews.post_type || 'notification'; %>
                                                            <span class="badge <%= typeBadgeColors[pt] || 'bg-secondary' %>">
                                                                <%= typeLabels[pt] || pt %>
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <strong><%= allNews.title %></strong>
                                                        </td>
                                                        <td>
                                                            <span style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; max-width: 350px;">
                                                                <%= allNews.short_description || allNews.description %>
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <% if (allNews.link) { %>
                                                                <a href="<%= allNews.link %>" target="_blank" class="btn btn-primary btn-sm">Open Link</a>
                                                            <% } else { %>
                                                                <span class="text-muted">-</span>
                                                            <% } %>
                                                        </td>
                                                        <% if (loginData.is_admin == 1) { %>
                                                            <td class="pe-0">
                                                                <form action="/news-is-active/<%= allNews._id %>/toggle" id="featureForm" method="POST">
                                                                    <input type="hidden" name="returnUrl" value="<%= currentViewUrl %>"/>
                                                                    <a id="toggleButton" >
                                                                        <div class="form-check form-switch mb-0">
                                                                            <input type="hidden" name="title" value="<%= allNews.title %>"/>
                                                                            <input class="form-check-input" type="checkbox" name="is_active" <% if(allNews.is_active == 1) { %> checked <% }else{} %>>
                                                                        </div>
                                                                    </a>
                                                                </form>
                                                            </td>
                                                            <td>
                                                                <div class="d-flex gap-3">
                                                                    <a href="#" class="text-info me-3 btn-view-news" data-title="<%= allNews.title %>" data-description="<%= allNews.short_description || allNews.description %>" data-link="<%= allNews.link || '' %>" data-post-type="<%= allNews.post_type || 'notification' %>" data-is-active="<%= allNews.is_active %>" data-bs-toggle="modal" data-bs-target="#viewNewsModal"><i class="bx bx-show"></i></a>
                                                                    <a href="/edit-news?id=<%= allNews._id %>&returnUrl=<%= encodeURIComponent(currentViewUrl) %>" class="text-success me-3"><i class="bx bx-edit-alt"></i></a>
                                                                    <a href="/delete-news?id=<%= allNews._id %>&returnUrl=<%= encodeURIComponent(currentViewUrl) %>" onclick="return confirm('Are you sure want to delete this news item?')" class="text-danger me-3"><i class="bx bx-trash"></i></a>
                                                                </div>
                                                            </td>
                                                            <% } else { %>
                                                            <td>
                                                                <div class="form-check form-switch mb-0" onclick="alert('You have no access to change status..!!')">
                                                                    <input class="form-check-input" type="checkbox" name="is_active"  <% if(allNews.is_active==1) { %> checked <% }else{} %>disabled>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="d-flex gap-3">
                                                                    <a href="#" class="text-info me-3 btn-view-news" data-title="<%= allNews.title %>" data-description="<%= allNews.short_description || allNews.description %>" data-link="<%= allNews.link || '' %>" data-post-type="<%= allNews.post_type || 'notification' %>" data-is-active="<%= allNews.is_active %>" data-bs-toggle="modal" data-bs-target="#viewNewsModal"><i class="bx bx-show"></i></a>
                                                                    <a href="/edit-news?id=<%= allNews._id %>" class="text-success me-3"><i class="bx bx-edit-alt"></i></a>
                                                                    <a href="" onclick="return alert('You have no access to delete this news item.')" class="text-danger"><i class="bx bx-trash"></i></a>
                                                                </div>
                                                            </td>
                                                            <%  }%>
                                                    </tr>
                                                <% }); %>
                                            </tbody>
                                         </table>
                                     </div>

                                 <%- include('../partials/pagination', { currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, limit: limit, extraParams: typeof extraParams !== 'undefined' ? extraParams : '' }) %>

                                 </div>
                             </div>
                         </div>
                     </div>

                     </div>
                 </div>
             </div>
         </div>
     </div>

<script type="text/javascript">
    const checkboxes = document.querySelectorAll('input[type="checkbox"]');

    checkboxes.forEach(function (checkbox) {
        checkbox.addEventListener('click', function (event) {
            const form = checkbox.closest('form');

            if (form) {
                const fieldName = form.querySelector('[name="title"]').value;

                const action = checkbox.checked ? 'Enable' : 'Disable';
                if (!confirm(`Are you sure you want to ${action} ${fieldName}?`)) {
                    event.preventDefault();
                    return;
                }

                const formData = new FormData(form);

                $.ajax({
                    type: "POST",
                    url: form.action,
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (data) {
                        console.log('Success:', data);
                    },
                    error: function (error) {
                        console.error('Error:', error);
                    }
                });
            }
        });
    });

    document.querySelectorAll('.btn-view-news').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            var typeLabels = { result: 'Result', admit_card: 'Admit Card', answer_key: 'Answer Key', notification: 'Notification', other: 'Other' };
            document.getElementById('viewNewsTitle').textContent = this.dataset.title;
            document.getElementById('viewNewsType').textContent = typeLabels[this.dataset.postType] || this.dataset.postType;
            document.getElementById('viewNewsDesc').innerHTML = this.dataset.description || '-';
            var linkEl = document.getElementById('viewNewsLink');
            if (this.dataset.link) {
                linkEl.innerHTML = '<a href="' + this.dataset.link + '" target="_blank">' + this.dataset.link + '</a>';
            } else {
                linkEl.textContent = '-';
            }
            document.getElementById('viewNewsStatus').innerHTML = this.dataset.isActive == '1' ? '<span class="badge bg-success">Enabled</span>' : '<span class="badge bg-danger">Disabled</span>';
        });
    });
</script>

<div class="modal fade" id="viewNewsModal" tabindex="-1" aria-labelledby="viewNewsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewNewsModalLabel">News Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table class="table table-borderless">
                    <tr><td class="fw-bold text-muted" style="width:120px;">Type</td><td id="viewNewsType"></td></tr>
                    <tr><td class="fw-bold text-muted">Title</td><td id="viewNewsTitle"></td></tr>
                    <tr><td class="fw-bold text-muted">Description</td><td id="viewNewsDesc"></td></tr>
                    <tr><td class="fw-bold text-muted">Link</td><td id="viewNewsLink"></td></tr>
                    <tr><td class="fw-bold text-muted">Status</td><td id="viewNewsStatus"></td></tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<%- include('../layout/footer.ejs') %>

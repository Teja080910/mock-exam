<%- include('../layout/header.ejs') %>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <%- include('../layout/sidebar.ejs') %>
                <div class="content-wrapper">
                    <div class="container-xxl flex-grow-1 container-p-y">
                        <div class="row">
                            <div class="col-md-8">
                                <h4 class="py-3 mb-4"><span class="text-muted fw-light"> Plan /</span> Edit Plan</h4>
                                <div class="card mb-4">
                                    <form action="" method="post">
                                        <div class="card-body">
                                            <% if(typeof message !=='undefined' ){ %>
                                                <div class="alert alert-primary alert-dismissible" role="alert">
                                                    <%= message %>
                                                        <button type="button" class="btn-close" data-bs-dismiss="alert"
                                                            aria-label="Close"></button>
                                                </div>
                                                <% } %>
                                                    <% if(flash.error.length> 0){ %>
                                                        <div class="alert alert-danger alert-dismissible" role="alert">
                                                            <%= flash.error %>
                                                                <button type="button" class="btn-close"
                                                                    data-bs-dismiss="alert" aria-label="Close"></button>
                                                        </div>
                                                        <% } %>
                                                            <div class="row">
                                                                <div class="col-md-12">
                                                                    <div class="col-md-12">
                                                                        <div class="row mb-3">
                                                                            <label class="col-sm-2 col-form-label"
                                                                                for="categoryGroup">Category
                                                                                Group</label>
                                                                            <div class="col-sm-10">
                                                                                <select class="form-control"
                                                                                    name="categoryGroup" required>
                                                                                    <option value="">Select Category
                                                                                        Group</option>
                                                                                    <option value="all"
                                                                                        <%=!plan.categoryGroup
                                                                                        ? 'selected' : '' %>>All
                                                                                        Category Groups</option>
                                                                                    <% categoryGroups.forEach(function(group)
                                                                                        { %>
                                                                                        <option value="<%= group._id %>"
                                                                                            <%=plan.categoryGroup &&
                                                                                            plan.categoryGroup.toString()===group._id.toString()
                                                                                            ? 'selected' : '' %>><%=
                                                                                                group.displayName %>
                                                                                        </option>
                                                                                        <% }); %>
                                                                                </select>
                                                                            </div>
                                                                        </div>
                                                                    <div class="row mb-3">
                                                                        <label class="col-sm-2 col-form-label"
                                                                            for="planName">Plan Name</label>
                                                                        <div class="col-sm-10">
                                                                            <input type="text" class="form-control"
                                                                                name="planName"
                                                                                value="<%= plan.planName %>"
                                                                                placeholder="Enter Plan Name"
                                                                                required />
                                                                        </div>
                                                                    </div>
                                                                    <div class="row mb-3">
                                                                        <label class="col-sm-2 col-form-label"
                                                                            for="description">Description</label>
                                                                        <div class="col-sm-10">
                                                                            <input type="text" class="form-control"
                                                                                name="description"
                                                                                value="<%= plan.description || '' %>"
                                                                                placeholder="e.g. Full Access All in One Category (shown under plan name in app)" />
                                                                        </div>
                                                                    </div>
                                                                        <div class="row mb-3">
                                                                            <label class="col-sm-2 col-form-label"
                                                                                for="planType">Plan Type</label>
                                                                            <div class="col-sm-10">
                                                                                <select class="form-control"
                                                                                    name="planType">
                                                                                    <option value="">Select Plan Type</option>
                                                                                    <option value="Standard Plan"
                                                                                        <%=plan.planType==='Standard Plan'
                                                                                        ? 'selected' : '' %>>Standard Plan</option>
                                                                                    <option value="Premium Plan"
                                                                                        <%=plan.planType==='Premium Plan'
                                                                                        ? 'selected' : '' %>>Premium Plan</option>
                                                                                </select>
                                                                            </div>
                                                                        </div>
                                                                        <div class="row mb-3">
                                                                            <label class="col-sm-2 col-form-label"
                                                                                for="features">Features</label>
                                                                            <div class="col-sm-10">
                                                                                <textarea class="form-control" rows="3"
                                                                                    name="features"
                                                                                    placeholder="One feature per line"><%= (plan.features || []).join('\n') %></textarea>
                                                                            </div>
                                                                        </div>
                                                                        <div class="row mb-3">
                                                                            <label class="col-sm-2 col-form-label"
                                                                                for="planValidity">Plan Validity</label>
                                                                            <div class="col-sm-10">
                                                                                <input type="text" class="form-control"
                                                                                    name="planValidity"
                                                                                    value="<%= plan.planValidity %>"
                                                                                    list="validityOptions"
                                                                                    placeholder="e.g. 1 Year" required />
                                                                                <datalist id="validityOptions">
                                                                                    <option value="1 Month"></option>
                                                                                    <option value="3 Month"></option>
                                                                                    <option value="6 Month"></option>
                                                                                    <option value="1 Year"></option>
                                                                                    <option value="Lifetime"></option>
                                                                                </datalist>
                                                                            </div>
                                                                        </div>
                                                                        <div class="row mb-3">
                                                                            <label class="col-sm-2 col-form-label"
                                                                                for="basic-icon-default-fullname">Price</label>
                                                                            <div class="col-sm-10">
                                                                                <div
                                                                                    class="input-group input-group-merge">
                                                                                    <input type="text"
                                                                                        class="form-control"
                                                                                        name="price"
                                                                                        value="<%= plan.price %>"
                                                                                        placeholder="Enter Price"
                                                                                        required />
                                                                                    <input type="hidden" name="id"
                                                                                        value="<%= plan._id %>">
                                                                                    <input type="hidden" name="returnUrl" value="<%= typeof returnUrl !== 'undefined' && returnUrl ? returnUrl : '' %>">
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="row">
                                                                        <div class="col-sm-2"></div>
                                                                        <div class="col-sm-10 mt-2">
                                                                            <button type="submit"
                                                                                class="btn btn-primary">Save</button>
                                                                            <a href="<%= typeof returnUrl !== 'undefined' && returnUrl ? returnUrl : '/view-plan' %>" class="ms-3 btn btn-dark">Back</a>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    <%- include('../layout/footer.ejs') %>
<%- include('../layout/header.ejs') %>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <%- include('../layout/sidebar.ejs') %>
                <div class="content-wrapper">
                    <div class="container-xxl flex-grow-1 container-p-y">
                        <div class="row">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h4 class="py-3 mb-4"> <span class="text-muted fw-light">Intro /</span> View Intro</h4>
                                    <div class="btnwrap mb-4">
                                        <a href="/add-intro" class="btn btn-primary"><i class='bx bx-plus'></i> Add New Intro</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <div class="row">
                        <div class="col-lg-12 grid-margin stretch-card">
                            <div class="card mb-4">
                                <div class="card-header pb-0">
                                    <h5 class="card-title mb-0">Filter Intro</h5>
                                </div>
                                <div class="card-body pt-3">
                                    <form method="get" action="/view-intro" id="introFilterForm">
                                        <div class="row g-3 align-items-center">
                                            <div class="col-md-3">
                                                <label class="form-label text-muted small fw-semibold">Status</label>
                                                <select name="is_active" class="form-select" onchange="document.getElementById('introFilterForm').submit()">
                                                    <option value="">All Status</option>
                                                    <option value="1" <%= typeof filters !== 'undefined' && filters.is_active === '1' ? 'selected' : '' %>>Enabled</option>
                                                    <option value="0" <%= typeof filters !== 'undefined' && filters.is_active === '0' ? 'selected' : '' %>>Disabled</option>
                                                </select>
                                            </div>
                                            <div class="col-md-9">
                                                <label class="form-label text-muted small fw-semibold">Search</label>
                                                <div class="input-group">
                                                    <input type="text" name="search" class="form-control" placeholder="Search intro title or description..." value="<%= typeof filters !== 'undefined' ? filters.search : '' %>" />
                                                    <button type="submit" class="btn btn-primary"><i class="bx bx-search"></i></button>
                                                </div>
                                            </div>
                                            <div class="col-12 d-flex justify-content-end gap-2">
                                                <% if (typeof filters !== 'undefined' && (filters.is_active !== '' || filters.search)) { %>
                                                    <a href="/view-intro" class="btn btn-outline-secondary btn-sm"><i class="bx bx-x"></i> Clear Filters</a>
                                                <% } %>
                                                <button type="submit" class="btn btn-primary btn-sm"><i class="bx bx-filter-alt"></i> Apply Filter</button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12 grid-margin stretch-card">
                            <div class="card">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-hover" id="server-intro-table">
                                            <thead>
                                                <tr>
                                                    <th>Sr No</th>
                                                    <th>Image</th>
                                                    <th>Title</th>
                                                    <th>Created At</th>
                                                    <th>Updated At</th>
                                                    <th>Is Enable</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (intro.length === 0) { %>
                                                    <tr>
                                                        <td colspan="7" class="text-center py-4 text-muted">
                                                            <i class="bx bx-info-circle fs-3 d-block mb-2"></i>
                                                            No intro items found matching your filter criteria.
                                                        </td>
                                                    </tr>
                                                <% } %>
                                                <% const currentViewUrl = '/view-intro?page=' + currentPage + (typeof extraParams !== 'undefined' ? extraParams : ''); %>
                                                <% intro.forEach(function(allIntro, i){ %>
                                                    <tr>
                                                        <td><%= (currentPage - 1) * limit + i + 1 %></td>
                                                        <td>
                                                            <ul class="list-unstyled users-list m-0 avatar-group d-flex align-items-center">
                                                                <li data-bs-toggle="tooltip"
                                                                    data-popup="tooltip-custom"
                                                                    data-bs-placement="top"
                                                                    class="avatar def-avatar avatar-xs pull-up" title="<%= allIntro.title %>"
                                                                    data-bs-original-title="">
                                                                    <img src="./assets/userImages/<%= allIntro.image %>"
                                                                        alt="Avatar" class="rounded-circle">
                                                                </li>
                                                            </ul>
                                                        </td>
                                                        <td>
                                                            <strong> <%= allIntro.title %></strong>
                                                        </td>
                                                        <td>
                                                            <strong><%= new Date(allIntro.createdAt).toLocaleDateString('en-GB', {day: '2-digit',month: '2-digit',year: 'numeric'}).replace(/\//g, '-') %></strong>
                                                        </td>
                                                        <td>
                                                            <strong><%= new Date(allIntro.updatedAt).toLocaleDateString('en-GB', {day: '2-digit',month: '2-digit',year: 'numeric'}).replace(/\//g, '-') %></strong>                                                            </td>
                                                        </td>
                                                        <% if (loginData.is_admin == 1) { %>
                                                            <td class="pe-0">
                                                                <form action="/intro-is-active/<%= allIntro._id %>/toggle" id="featureForm" method="POST">
                                                                    <input type="hidden" name="returnUrl" value="<%= currentViewUrl %>"/>
                                                                    <a id="toggleButton" >
                                                                        <div class="form-check form-switch mb-0">
                                                                            <input type="hidden" name="title" value="<%= allIntro.title %>"/>
                                                                            <input class="form-check-input" type="checkbox" name="is_active"  <% if(allIntro.is_active == 1) { %> checked <% }else{} %>>
                                                                        </div>
                                                                    </a>
                                                                </form>                   
                                                            </td>
                                                            <td>
                                                                <div class="d-flex gap-3">
                                                                    <a href="#" class="text-info me-3 btn-view-intro" data-title="<%= allIntro.title %>" data-description="<%= allIntro.description %>" data-image="<%= allIntro.image %>" data-is-active="<%= allIntro.is_active %>" data-bs-toggle="modal" data-bs-target="#viewIntroModal"><i class="bx bx-show"></i></a>
                                                                    <a href="/edit-intro?id=<%= allIntro._id %>&returnUrl=<%= encodeURIComponent(currentViewUrl) %>" class="text-success me-3"><i class="bx bx-edit-alt"></i></a>
                                                                    <a href="/delete-intro?id=<%= allIntro._id %>&returnUrl=<%= encodeURIComponent(currentViewUrl) %>" onclick="return confirm('Are you sure want to delete this <%= allIntro.title %> ?' )" class="text-danger me-3"><i class="bx bx-trash"></i></a>
                                                                </div>
                                                            </td>
                                                        <% } else { %>
                                                            <td>
                                                                <div class="form-check form-switch" onclick="alert('You have no access to change status..!!')">
                                                                    <input class="form-check-input" type="checkbox" name="is_active"  <% if(allIntro.is_active==1) { %> checked <% }else{} %>disabled>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <div class="d-flex gap-3">
                                                                    <a href="#" class="text-info me-3 btn-view-intro" data-title="<%= allIntro.title %>" data-description="<%= allIntro.description %>" data-image="<%= allIntro.image %>" data-is-active="<%= allIntro.is_active %>" data-bs-toggle="modal" data-bs-target="#viewIntroModal"><i class="bx bx-show"></i></a>
                                                                    <a href="/edit-intro?id=<%= allIntro._id %>&returnUrl=<%= encodeURIComponent(currentViewUrl) %>" class="text-success me-3"><i class="bx bx-edit-alt"></i></a><a href="" onclick="return alert('You have no access to delete <%= allIntro.title %>.' )" class="text-danger me-3"><i class="bx bx-trash"></i></a>
                                                                </div>
                                                            </td>
                                                        <%  }  %>
                                                    </tr>
                                                <% }); %>
                                            </tbody>
                                         </table>
                                     </div>

                                     <%- include('../partials/pagination', { currentPage: currentPage, totalPages: totalPages, totalItems: totalItems, limit: limit, extraParams: typeof extraParams !== 'undefined' ? extraParams : '' }) %>

                                     </div>
                                 </div>

                             </div>
                        </div>
                    </div>
                </div>
            </div>

        <script src="/assets/js/statusEnable.js"></script>

<div class="modal fade" id="viewIntroModal" tabindex="-1" aria-labelledby="viewIntroModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewIntroModalLabel">Intro Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <img id="viewIntroImage" src="" alt="Intro Image" class="rounded-circle modal-img-viewable" style="width: 80px; height: 80px; object-fit: cover;">
                </div>
                <table class="table table-borderless">
                    <tr><td class="fw-bold text-muted" style="width:120px;">Title</td><td id="viewIntroTitle"></td></tr>
                    <tr><td class="fw-bold text-muted">Description</td><td id="viewIntroDesc"></td></tr>
                    <tr><td class="fw-bold text-muted">Status</td><td id="viewIntroStatus"></td></tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.btn-view-intro').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            document.getElementById('viewIntroImage').src = './assets/userImages/' + this.dataset.image;
            document.getElementById('viewIntroTitle').textContent = this.dataset.title;
            document.getElementById('viewIntroDesc').innerHTML = this.dataset.description || '-';
            document.getElementById('viewIntroStatus').innerHTML = this.dataset.isActive == '1' ? '<span class="badge bg-success">Enabled</span>' : '<span class="badge bg-danger">Disabled</span>';
        });
    });
</script>

<%- include('../partials/imageViewer') %>

<%- include('../layout/footer.ejs') %>

<%- include('../layout/header.ejs') %>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <%- include('../layout/sidebar.ejs') %>
                <div class="content-wrapper">
                    <div class="container-xxl flex-grow-1 container-p-y">
                        <div class="row">
                            <div class="col-md-8">
                                <h4 class="py-3 mb-4">
                                    <span class="text-muted fw-light">News /</span> Add News
                                </h4>
                                <div class="card mb-4">
                                    <form action="" method="post" enctype="multipart/form-data">
                                        <div class="card-body">
                                            <% if(typeof message !=='undefined' ){ %>
                                                <div class="alert alert-primary alert-dismissible" role="alert">
                                                    <%= message %>
                                                        <button type="button" class="btn-close" data-bs-dismiss="alert"
                                                            aria-label="Close"></button>
                                                </div>
                                                <% } %>
                                                    <% if(flash.error.length> 0){ %>
                                                        <div class="alert alert-danger alert-dismissible" role="alert">
                                                            <%= flash.error %>
                                                                <button type="button" class="btn-close"
                                                                    data-bs-dismiss="alert" aria-label="Close"></button>
                                                        </div>
                                                        <% } %>
                                                            <div class="row">
                                                                <div class="col-md-12">
                                                                    <div class="row mb-3">
                                                                        <label class="col-sm-2 col-form-label"
                                                                            for="title">Title</label>
                                                                        <div class="col-sm-10">
                                                                            <div class="input-group input-group-merge">
                                                                                <input type="text" class="form-control"
                                                                                    name="title" value=""
                                                                                    placeholder="e.g. SSC CGL 2026 Tier 1 Result Declared"
                                                                                    required />
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="row mb-3">
                                                                        <label class="col-sm-2 col-form-label"
                                                                            for="category">Category</label>
                                                                        <div class="col-sm-10">
                                                                            <div class="input-group input-group-merge">
                                                                                <input type="text" class="form-control"
                                                                                    name="category" value=""
                                                                                    placeholder="e.g. Government Exams, Banking, Railway" />
                                                                            </div>
                                                                            <small class="text-muted">e.g. Government Exams, Banking, Railway, SSC, UPSC</small>
                                                                        </div>
                                                                    </div>
                                                                    <div class="row mb-3">
                                                                        <label class="col-sm-2 col-form-label"
                                                                            for="post_type">Post Type</label>
                                                                        <div class="col-sm-10">
                                                                            <select class="form-select" name="post_type" id="post_type" required>
                                                                                <option value="notification" selected>Notification</option>
                                                                                <option value="result">Result</option>
                                                                                <option value="admit_card">Admit Card</option>
                                                                                <option value="answer_key">Answer Key</option>
                                                                                <option value="other">Other</option>
                                                                            </select>
                                                                        </div>
                                                                    </div>
                                                                    <div class="row mb-3">
                                                                        <label class="col-sm-2 col-form-label"
                                                                            for="image">Banner Image</label>
                                                                        <div class="col-sm-10">
                                                                            <input type="file" class="form-control"
                                                                                name="image" accept="image/*" />
                                                                            <small class="text-muted">Upload a banner image for the news post (recommended: 800x400px)</small>
                                                                        </div>
                                                                    </div>
                                                                    <div class="row mb-3">
                                                                        <label class="col-sm-2 col-form-label"
                                                                            for="short_description">Short Description</label>
                                                                        <div class="col-sm-10">
                                                                            <textarea class="form-control" name="short_description"
                                                                                rows="4" maxlength="500"
                                                                                placeholder="Write a short post (50–100 words) about results, admit cards, answer keys, etc."
                                                                                required></textarea>
                                                                            <small class="text-muted">Max 500 characters. Keep it concise — 50 to 100 words recommended.</small>
                                                                        </div>
                                                                    </div>
                                                                    <div class="row mb-3">
                                                                        <label class="col-sm-2 col-form-label"
                                                                            for="link">Website
                                                                            Link (optional)</label>
                                                                        <div class="col-sm-10">
                                                                            <div class="input-group input-group-merge">
                                                                                <input type="url" class="form-control"
                                                                                    name="link" value=""
                                                                                    placeholder="https://example.com" />
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="row mb-3">
                                                                        <label class="col-sm-2 col-form-label"
                                                                            for="is_active">Is
                                                                            Active</label>
                                                                        <div class="col-sm-10">
                                                                            <div class="form-check form-switch mb-2">
                                                                                <input class="form-check-input"
                                                                                    type="checkbox"
                                                                                    id="flexSwitchCheckDefault"
                                                                                    name="is_active">
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="row mt-5">
                                                                    <div class="col-sm-2"></div>
                                                                    <div class="col-sm-10">
                                                                        <button type="submit" class="btn btn-primary">Submit</button>
                                                                        <a href="/view-news"
                                                                            class="ms-3 btn btn-dark">Back</a>
                                                                    </div>
                                                                </div>
                                                            </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                    <%- include('../layout/footer.ejs') %>
